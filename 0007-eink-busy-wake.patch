+    epd4g_map(EPD4G_ROT_90, 60, 50, &nx, &ny);  CHECK(nx == 176 - 1 - 50 && ny == 60, "ROT_90 mapping");
+    epd4g_map(EPD4G_ROT_270, 60, 50, &nx, &ny); CHECK(nx == 50 && ny == 264 - 1 - 60, "ROT_270 mapping");
