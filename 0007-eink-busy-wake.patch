+/* ======================= non-blocking interface =========================== */
+static int cb_calls, cb_rc;
+static void done_cb(int rc, void *ctx) { cb_calls++; cb_rc = rc; (void)ctx; }
+
+/* run a job with poll(): the "main loop" does other work and time passes by itself. Returns the
+ * largest number of SPI bytes sent by one poll call. */
+static long run_async(long *loops, int *max_pending_ms)
+{
+    long worst = 0, n = 0;
+    uint32_t t_start = now_ms;
+    while (epd4g_is_busy()) {
+        long b0 = spi_bytes;
+        uint32_t t0 = now_ms;
+        int pending = epd4g_poll();
+        CHECK(now_ms == t0, "poll() must not sleep or advance time itself");
+        if (spi_bytes - b0 > worst) worst = spi_bytes - b0;
+        CHECK(pending == 0 || pending == EPD4G_PENDING, "poll status");
+        n++;                                    /* the rest of the main loop: GNSS, buttons, ... */
+        now_ms += 1;                            /* 1 ms per main loop pass */
+        CHECK(now_ms - t_start < 60000, "job does not finish");
+        if (now_ms - t_start >= 60000) break;
+    }
+    if (loops) *loops = n;
+    if (max_pending_ms) *max_pending_ms = (int)(now_ms - t_start);
+    return worst;
+}
+
+static void test_async(void)
+{
+    static uint8_t fb[EPD4G_FB_BYTES], fb2[EPD4G_FB_BYTES], mask[EPD4G_MASK_BYTES], img[EPD4G_BW_FB_BYTES];
+    long loops, worst; int ms;
+    const long slice_limit = (long)EPD4G_ROWS_PER_POLL * EPD4G_FB_STRIDE + 400;   /* rows + a few register writes */
+
+    sim_bw = 0; busy_until = 0;
+    random_fb(fb);
+    CHECK(epd4g_start_init() == EPD4G_OK, "start init");
+    CHECK(epd4g_is_busy(), "busy after start");
+    CHECK(epd4g_start_init() == EPD4G_ERR_BUSY, "second job while running");
+    CHECK(epd4g_start_full(fb, EPD4G_FULL_FAST) == EPD4G_ERR_BUSY, "full while init is running");
+    CHECK(epd4g_start_sleep() == EPD4G_ERR_BUSY, "sleep while running");
+    worst = run_async(&loops, &ms);
+    CHECK(!epd4g_is_busy() && epd4g_result() == EPD4G_OK, "init result %d", epd4g_result());
+    CHECK(worst <= slice_limit, "init: %ld bytes in one poll", worst);
+
+    /* a full refresh: bounded work per poll, the main loop keeps running during the waveform */
+    epd4g_set_done_cb(done_cb, NULL); cb_calls = 0;
+    mode_partial = 0;
+    CHECK(epd4g_start_full(fb, EPD4G_FULL_FAST) == EPD4G_OK, "start full");
+    worst = run_async(&loops, &ms);
+    CHECK(epd4g_result() == EPD4G_OK && cb_calls == 1 && cb_rc == EPD4G_OK, "full result / callback");
+    CHECK(worst <= slice_limit, "full: %ld bytes in one poll (limit %ld)", worst, slice_limit);
+    CHECK(ms >= 100 * 20 && loops > 100, "full: %d ms, %ld loop passes: main loop starved?", ms, loops);
+    check_ink_equals(fb, "async full");
+    epd4g_set_done_cb(NULL, NULL);
+
+    /* the frame buffer is free again as soon as its data is sent, long before the job ends */
+    {
+        static uint8_t keep[EPD4G_FB_BYTES];
+        memcpy(keep, fb, sizeof keep);
+        CHECK(!epd4g_data_busy(), "no data in use when idle");
+        mode_partial = 0;
+        CHECK(epd4g_start_full(fb, EPD4G_FULL_FAST) == EPD4G_OK && epd4g_data_busy(), "data in use after start");
+        long released_at = -1, polls = 0;
+        while (epd4g_is_busy()) {
+            epd4g_poll(); polls++; now_ms++;
+            if (released_at < 0 && !epd4g_data_busy()) { released_at = polls; epd4g_fb_fill(fb, EPD4G_BLACK); }   /* next frame is drawn meanwhile */
+            if (polls > 100000) break;
+        }
+        CHECK(released_at > 0 && released_at < polls / 4, "data released at poll %ld of %ld", released_at, polls);
+        CHECK(epd4g_result() == EPD4G_OK, "full result");
+        check_ink_equals(keep, "full with the buffer overwritten after release");
+        memcpy(fb, keep, sizeof fb);
+    }
+
+    /* partial through the diff helper: same picture as the blocking call, no panel access if equal */
+    memcpy(fb2, fb, sizeof fb2);
+    for (int y = 50; y < 80; y++) for (int x = 40; x < 100; x++) epd4g_fb_set(fb2, x, y, (uint8_t)((x * 3 + y) & 3));
+    uint32_t changed = 0;
+    mode_partial = 1; pass_no = 0; expect_fb = fb2;
+    clear_stream();
+    CHECK(epd4g_start_partial_diff(fb, fb2, NULL, &changed) == EPD4G_OK && changed > 0, "start partial diff");
+    CHECK(epd4g_start_partial_diff(fb, fb2, NULL, &changed) == EPD4G_ERR_BUSY, "diff while the mask is in use");
+    uint32_t t_mid = now_ms;
+    worst = run_async(&loops, &ms);
+    mode_partial = 0;
+    CHECK(epd4g_result() == EPD4G_OK, "partial result");
+    CHECK(worst <= slice_limit, "partial: %ld bytes in one poll", worst);
+    CHECK(now_ms - t_mid >= 40 * 20 && loops > 40, "partial waveform wait: %u ms", now_ms - t_mid);
+    check_ink_equals(fb2, "async partial");
+    CHECK(!epd4g_data_busy(), "data free after the job");
+    /* no change: the panel is not touched, but a (no-op) job finishes in the next poll */
+    clear_stream(); cb_calls = 0; epd4g_set_done_cb(done_cb, NULL);
+    CHECK(epd4g_start_partial_diff(fb2, fb2, NULL, &changed) == EPD4G_OK && changed == 0 && epd4g_is_busy(), "no change: no-op job");
+    run_async(NULL, NULL);
+    CHECK(stream_n == 0 && epd4g_result() == EPD4G_OK && cb_calls == 1, "no change: panel untouched, callback called");
+    epd4g_set_done_cb(NULL, NULL);
+
+    /* the blocking twin sends exactly the same bytes */
+    {
+        static uint16_t a[8192]; int na;
+        memcpy(fb, fb2, sizeof fb);
+        for (int y = 120; y < 140; y++) for (int x = 10; x < 60; x++) epd4g_fb_set(fb, x, y, (uint8_t)((x + y * 5) & 3));
+        mode_partial = 1; pass_no = 0; expect_fb = fb; clear_stream();
+        CHECK(epd4g_start_partial_diff(fb2, fb, NULL, &changed) == EPD4G_OK, "start");
+        run_async(NULL, NULL);
+        na = stream_n < 8192 ? stream_n : 8192; memcpy(a, stream, (size_t)na * sizeof a[0]);
+        /* panel state is now "fb"; redo the same update (fb2 -> fb) from the old picture in blocking mode */
+        mode_partial = 0;
+        CHECK(epd4g_full(fb2, EPD4G_FULL_FAST) == EPD4G_OK, "restore");
+        mode_partial = 1; pass_no = 0; expect_fb = fb; clear_stream();
+        CHECK(epd4g_partial_diff(fb2, fb, NULL, &changed) == EPD4G_OK, "blocking diff");
+        CHECK(stream_n == na && memcmp(stream, a, (size_t)na * sizeof a[0]) == 0, "blocking and non-blocking streams differ");
+        mode_partial = 0;
+    }
+
+    /* 1-bit jobs: chained from the callback, as a UI state machine would */
+    sim_bw = 1; bw_random(img);
+    CHECK(epd4g_start_bw_init(EPD4G_BW_NORMAL) == EPD4G_OK, "start bw init");
+    CHECK(epd4g_start_bw_full(img, EPD4G_SRC_1BPP, EPD4G_BW_NORMAL) == EPD4G_ERR_BUSY, "bw full while init");
+    worst = run_async(&loops, &ms);
+    CHECK(epd4g_result() == EPD4G_OK, "bw init result");
+    CHECK(epd4g_start_bw_full(img, EPD4G_SRC_1BPP, EPD4G_BW_NORMAL) == EPD4G_OK, "start bw full");
+    worst = run_async(&loops, &ms);
+    CHECK(worst <= (long)EPD4G_ROWS_PER_POLL * EPD4G_BW_STRIDE + 400, "bw full: %ld bytes in one poll", worst);
+    check_bw_shows(img, "async bw full");
+    epd4g_rect_t r = { 30, 60, 90, 90 };
+    bw_random(img);
+    uint32_t t1 = now_ms;
+    CHECK(epd4g_start_bw_partial(img, EPD4G_SRC_1BPP, &r) == EPD4G_OK, "start bw partial");
+    worst = run_async(&loops, &ms);
+    CHECK(epd4g_result() == EPD4G_OK, "bw partial result");
+    CHECK(now_ms - t1 >= 300 && loops > 200, "bw partial: main loop ran %ld passes in %u ms", loops, now_ms - t1);
+    sim_bw = 0;
+
+    /* abort drops the job and requires a new init */
+    CHECK(epd4g_start_init() == EPD4G_OK, "start");
+    epd4g_abort();
+    CHECK(!epd4g_is_busy(), "abort");
+    CHECK(epd4g_start_full(fb, EPD4G_FULL_FAST) == EPD4G_ERR_NOT_INIT, "after abort");
+
+    /* timeout in the non-blocking interface */
+    busy_stuck = 0; busy_until = 0;
+    CHECK(epd4g_start_init() == EPD4G_OK, "start");
+    run_async(NULL, NULL);
+    busy_stuck = 1;
+    CHECK(epd4g_start_full(fb, EPD4G_FULL_FAST) == EPD4G_OK, "start");
+    uint32_t t2 = now_ms;
+    run_async(NULL, NULL);
+    CHECK(epd4g_result() == EPD4G_ERR_TIMEOUT && now_ms - t2 >= EPD4G_BUSY_TIMEOUT_MS && now_ms - t2 < EPD4G_BUSY_TIMEOUT_MS + 1000, "timeout: rc %d after %u ms", epd4g_result(), now_ms - t2);
+    busy_stuck = 0; busy_until = 0;
+    (void)mask;
+}
+
+
+/* ===================== no-op jobs, automatic full refresh ================= */
+static void test_noop_jobs(void)
+{
+    static uint8_t fb[EPD4G_FB_BYTES], fb2[EPD4G_FB_BYTES];
+    uint32_t changed = 99;
+    sim_bw = 0; busy_until = 0; mode_partial = 0;
+    epd4g_fb_fill(fb, EPD4G_WHITE); memcpy(fb2, fb, sizeof fb2);
+    epd4g_fb_set(fb2, 5, 5, EPD4G_BLACK);
+
+    /* wrong state is reported before anything else, also when nothing differs */
+    epd4g_abort();
+    CHECK(epd4g_gray_ready() == EPD4G_ERR_NOT_INIT, "gray_ready before init");
+    CHECK(epd4g_start_partial_diff(fb, fb, NULL, &changed) == EPD4G_ERR_NOT_INIT, "diff before init");
+    CHECK(epd4g_init() == EPD4G_OK && epd4g_gray_ready() == EPD4G_OK, "init");
+    CHECK(epd4g_full(fb, EPD4G_FULL_FAST) == EPD4G_OK, "full");
+
+    epd4g_set_done_cb(done_cb, NULL);
+    /* blocking diff without changes: returns OK, nothing sent */
+    clear_stream(); cb_calls = 0;
+    CHECK(epd4g_partial_diff(fb, fb, NULL, &changed) == EPD4G_OK && changed == 0 && stream_n == 0 && cb_calls == 1, "blocking diff, no change");
+
+#if EPD4G_KEEP_POWER
+    /* the analog part is on after the full refresh: the first power_off is real, the second is a no-op */
+    clear_stream(); cb_calls = 0;
+    CHECK(epd4g_power_off() == EPD4G_OK && stream_n == 3 && cb_calls == 1, "power_off (real)");
+    clear_stream(); cb_calls = 0;
+    CHECK(epd4g_power_off() == EPD4G_OK && stream_n == 0 && cb_calls == 1, "power_off when already off sends nothing, callback called");
+#endif
+    /* sleep sends only the sleep command when the analog part is off (stock Sleep) */
+    clear_stream(); cb_calls = 0;
+    CHECK(epd4g_sleep() == EPD4G_OK && stream_n == 2 && stream[0] == golden_sleep[0] && stream[1] == golden_sleep[1], "sleep stream");
+    epd4g_set_done_cb(NULL, NULL);
+    CHECK(epd4g_init() == EPD4G_OK, "re-init");
+
+    /* the helpers refuse a busy library without touching the shared mask */
+    CHECK(epd4g_start_partial_diff(fb, fb2, NULL, &changed) == EPD4G_OK && changed == 1, "start diff");
+    CHECK(epd4g_start_noop() == EPD4G_ERR_BUSY, "noop while a job runs");
+    mode_partial = 1; pass_no = 0; expect_fb = fb2;
+    run_async(NULL, NULL);
+    mode_partial = 0;
+    check_ink_equals(fb2, "diff after noop tests");
+}
+
+static void test_auto_full_gray(void)
+{
+    static uint8_t a[EPD4G_FB_BYTES], b[EPD4G_FB_BYTES];
+    uint32_t changed;
+    int before;
+    sim_bw = 0; busy_until = 0; mode_partial = 0;
+    epd4g_set_partials_before_full(3, 0);
+    random_fb(a);
+    CHECK(epd4g_init() == EPD4G_OK && epd4g_full(a, EPD4G_FULL_FAST) == EPD4G_OK, "init + full");
+    CHECK(epd4g_partials_since_full() == 0 && !epd4g_full_due(), "counter after full");
+
+    for (int i = 1; i <= 3; i++) {                      /* three real partial updates: two passes each */
+        memcpy(b, a, sizeof b);
+        for (int y = 20 * i; y < 20 * i + 10; y++) for (int x = 30; x < 60; x++) epd4g_fb_set(b, x, y, (uint8_t)((x + y + i) & 3));
+        mode_partial = 1; pass_no = 0; expect_fb = b; before = updates_seen;
+        CHECK(epd4g_partial_diff(a, b, NULL, &changed) == EPD4G_OK && changed > 0, "partial %d", i);
+        mode_partial = 0;
+        CHECK(updates_seen - before <= 2 && epd4g_partials_since_full() == (unsigned)i, "partial %d counted (%u)", i, epd4g_partials_since_full());
+        check_ink_equals(b, "auto-full: partial");
+        memcpy(a, b, sizeof a);
+    }
+    CHECK(epd4g_full_due(), "full due after 3 partial updates");
+
+    /* nothing changed: no job to promote, the counter stays */
+    CHECK(epd4g_partial_diff(a, a, NULL, &changed) == EPD4G_OK && changed == 0 && epd4g_partials_since_full() == 3, "no-op does not count");
+
+    /* the 4th request becomes ONE full refresh of the same frame, and resets the counter */
+    memcpy(b, a, sizeof b);
+    for (int y = 100; y < 110; y++) for (int x = 70; x < 90; x++) epd4g_fb_set(b, x, y, (uint8_t)((x * 7 + y) & 3));
+    before = updates_seen;
+    CHECK(epd4g_partial_diff(a, b, NULL, &changed) == EPD4G_OK && changed > 0, "promoted partial");
+    CHECK(updates_seen - before == 1, "promoted request must be one full update, got %d", updates_seen - before);
+    check_ink_equals(b, "auto-full: picture after the promoted full refresh");
+    CHECK(epd4g_partials_since_full() == 0 && !epd4g_full_due(), "counter reset by the full refresh");
+    memcpy(a, b, sizeof a);
+
+    /* the rect variant is promoted too */
+    epd4g_set_partials_before_full(1, 0);
+    mode_partial = 1; pass_no = 0; expect_fb = a;
+    epd4g_rect_t r = { 0, 0, 20, 20 };
+    CHECK(epd4g_partial_rect(a, &r) == EPD4G_OK, "rect partial");
+    mode_partial = 0;
+    before = updates_seen;
+    CHECK(epd4g_partial_rect(a, &r) == EPD4G_OK && updates_seen - before == 1, "rect promoted to full");
+
+    /* 0 = never */
+    epd4g_set_partials_before_full(0, 0);
+    for (int i = 0; i < 15; i++) {
+        mode_partial = 1; pass_no = 0; expect_fb = a;
+        CHECK(epd4g_partial_rect(a, &r) == EPD4G_OK, "partial with limit 0");
+        mode_partial = 0;
+    }
+    CHECK(epd4g_partials_since_full() == 15 && !epd4g_full_due(), "limit 0 never promotes");
+    CHECK(epd4g_full(a, EPD4G_FULL_FAST) == EPD4G_OK && epd4g_partials_since_full() == 0, "explicit full resets the counter");
+}
+
+static void test_auto_full_bw(void)
+{
+    static uint8_t img[EPD4G_BW_FB_BYTES], img2[EPD4G_BW_FB_BYTES], want[EPD4G_BW_FB_BYTES];
+    epd4g_rect_t r = { 16, 40, 87, 99 };
+    int full0, part0;
+    sim_bw = 1;
+    epd4g_set_partials_before_full(0, 2);
+    CHECK(epd4g_bw_init(EPD4G_BW_NORMAL) == EPD4G_OK, "bw init");
+    bw_random(img);
+    CHECK(epd4g_bw_full(img, EPD4G_SRC_1BPP, EPD4G_BW_NORMAL) == EPD4G_OK && epd4g_partials_since_full() == 0, "bw full");
+    for (int i = 0; i < 2; i++) {
+        bw_random(img2);
+        memcpy(want, img, sizeof want);
+        for (int y = r.y0; y <= r.y1; y++) memcpy(&want[y * 22 + 2], &img2[y * 22 + 2], 9);
+        CHECK(epd4g_bw_partial(img2, EPD4G_SRC_1BPP, &r) == EPD4G_OK, "bw partial %d", i);
+        check_bw_shows(want, "bw partial before the limit");
+        memcpy(img, want, sizeof img);
+    }
+    CHECK(epd4g_partials_since_full() == 2 && epd4g_full_due(), "bw: due after 2 partials");
+
+    /* third request: the whole frame is drawn with a full refresh, not only the window */
+    bw_random(img2);
+    full0 = bw_full_updates; part0 = bw_part_updates;
+    CHECK(epd4g_bw_partial(img2, EPD4G_SRC_1BPP, &r) == EPD4G_OK, "bw promoted partial");
+    CHECK(bw_full_updates == full0 + 1 && bw_part_updates == part0, "one full update, no partial one");
+    check_bw_shows(img2, "bw: whole frame after the promoted full refresh");
+    CHECK(epd4g_partials_since_full() == 0, "bw: counter reset");
+    memcpy(img, img2, sizeof img);
+
+#if EPD4G_BW_PARTIAL_RESET
+    /* after deep sleep: the library runs the init first, then the full refresh */
+    for (int i = 0; i < 2; i++) {
+        bw_random(img2);
+        CHECK(epd4g_bw_partial(img2, EPD4G_SRC_1BPP, &r) == EPD4G_OK, "bw partial");
+        memcpy(want, img, sizeof want);
+        for (int y = r.y0; y <= r.y1; y++) memcpy(&want[y * 22 + 2], &img2[y * 22 + 2], 9);
+        memcpy(img, want, sizeof img);
+    }
+    CHECK(epd4g_sleep() == EPD4G_OK, "bw sleep");
+    bw_random(img2);
+    full0 = bw_full_updates; part0 = bw_part_updates; rst_n = 0;
+    CHECK(epd4g_bw_partial(img2, EPD4G_SRC_1BPP, &r) == EPD4G_OK, "bw promoted partial after sleep");
+    CHECK(bw_full_updates == full0 + 1 && bw_part_updates == part0 && rst_n >= 3, "init + full refresh (resets: %d)", rst_n);
+    check_bw_shows(img2, "bw: frame after sleep + promoted full refresh");
+    CHECK(epd4g_partials_since_full() == 0, "bw: counter reset after sleep case");
+#endif
+    epd4g_set_partials_before_full(0, 0);
+    sim_bw = 0;
+}
+
+#if EPD4G_AUTO_POWEROFF_MS > 0 && EPD4G_KEEP_POWER
+static void test_auto_poweroff(void)
+{
+    static uint8_t fb[EPD4G_FB_BYTES];
+    sim_bw = 0; busy_until = 0; mode_partial = 0;
+    epd4g_fb_fill(fb, EPD4G_WHITE);
+    CHECK(epd4g_init() == EPD4G_OK && epd4g_full(fb, EPD4G_FULL_FAST) == EPD4G_OK, "init + full");
+    epd4g_set_done_cb(done_cb, NULL); cb_calls = 0;
+    int res = epd4g_result();
+
+    now_ms += EPD4G_AUTO_POWEROFF_MS / 2;                /* too early */
+    clear_stream();
+    CHECK(epd4g_poll() == 0 && !epd4g_is_busy() && stream_n == 0, "no power-off before the idle time");
+    now_ms += EPD4G_AUTO_POWEROFF_MS;
+    CHECK(epd4g_poll() == EPD4G_PENDING && epd4g_is_busy(), "idle long enough: power-off job starts");
+    CHECK(epd4g_start_full(fb, EPD4G_FULL_FAST) == EPD4G_ERR_BUSY, "the automatic job is a normal job");
+    run_async(NULL, NULL);
+    CHECK(stream_n == 3 && stream[0] == 0x022 && stream[1] == 0x183 && stream[2] == 0x020, "automatic power-off stream");
+    CHECK(cb_calls == 0 && epd4g_result() == res, "the automatic job is silent");
+    now_ms += 10 * EPD4G_AUTO_POWEROFF_MS; clear_stream();
+    CHECK(epd4g_poll() == 0 && stream_n == 0, "only once");
+    epd4g_set_done_cb(NULL, NULL);
+
+    /* the next update powers the panel up again and works as usual */
+    CHECK(epd4g_full(fb, EPD4G_FULL_FAST) == EPD4G_OK, "full after the automatic power-off");
+}
+#endif
+
+/* ===== epd4g_wait_hint(): sleeping as the hint says gives the same picture with few polls ===== */
+static void run_hinted(long *polls, long *timer_waits, long *busy_waits)
+{
+    *polls = *timer_waits = *busy_waits = 0;
+    for (;;) {
+        int ob = -1;
+        epd4g_poll(); (*polls)++;
+        if (!epd4g_is_busy()) break;
+        uint32_t h = epd4g_wait_hint(&ob);
+        CHECK(h != EPD4G_WAIT_FOREVER, "a running job never reports FOREVER");
+        if (h == 0) {
+            /* SPI data slice or a wait that is over: poll again at once */
+        } else if (ob == 1) {
+            CHECK(epd4g_port_gpio_busy() == 1, "BUSY wait is reported only while BUSY is high");
+            (*busy_waits)++;
+            if (now_ms < busy_until) now_ms = busy_until;      /* woken by the falling edge of BUSY */
+            else now_ms += h;
+        } else {
+            CHECK(ob == 0, "on_busy is 0 for a timer wait");
+            (*timer_waits)++;
+            now_ms += h;                                        /* slept for the whole hint */
+        }
+        if (*polls > 100000) { CHECK(0, "wait_hint loop does not converge"); break; }
+    }
+}
+
+static void test_wait_hint(void)
+{
+    static uint8_t fb[EPD4G_FB_BYTES];
+    long polls, tw, bw;
+    int ob = -1;
+    uint32_t h;
+
+    sim_bw = 0; busy_until = 0; mode_partial = 0;
+    random_fb(fb);
+
+    h = epd4g_wait_hint(&ob);                    /* no job: forever, or the automatic power-off delay */
+    CHECK((h == EPD4G_WAIT_FOREVER || h > 0 || EPD4G_AUTO_POWEROFF_MS > 0) && ob == 0, "idle hint");
+
+    CHECK(epd4g_start_init() == EPD4G_OK, "start init");
+    CHECK(epd4g_wait_hint(&ob) == 0, "a job that has not run yet: poll at once");
+    run_hinted(&polls, &tw, &bw);
+    CHECK(epd4g_result() == EPD4G_OK, "hinted init result %d", epd4g_result());
+    CHECK(tw >= 1, "init waits on timers: %ld (on BUSY: %ld)", tw, bw);
+
+    CHECK(epd4g_start_full(fb, EPD4G_FULL_FAST) == EPD4G_OK, "start full");
+    run_hinted(&polls, &tw, &bw);
+    CHECK(epd4g_result() == EPD4G_OK, "hinted full result %d", epd4g_result());
+    check_ink_equals(fb, "hinted full");
+    CHECK(bw >= 1, "the waveform is waited for on BUSY (%ld)", bw);
+    CHECK(polls < 2000, "hinted full needed %ld polls (a 1 ms polling loop needs thousands)", polls);
+
+    /* BUSY already low: the hint says poll now rather than sleep */
+    busy_until = 0;
+    h = epd4g_wait_hint(&ob);
+    CHECK(h == EPD4G_WAIT_FOREVER || h > 0 || EPD4G_AUTO_POWEROFF_MS > 0, "idle after the job");
+    CHECK(epd4g_start_noop() == EPD4G_OK && epd4g_wait_hint(&ob) == 0, "noop job: poll at once");
+    run_hinted(&polls, &tw, &bw);
+}
+
+/* ===== fb helpers: byte-wise versions against the obvious per-pixel ones ===== */
+static void test_fb_fast_helpers(void)
+{
+    static uint8_t m1[EPD4G_MASK_BYTES], m2[EPD4G_MASK_BYTES], g4[EPD4G_FB_BYTES], bw[EPD4G_BW_FB_BYTES];
+    for (int it = 0; it < 3000; it++) {
+        epd4g_rect_t r;
+        r.x0 = (int)(rnd() % 220) - 20; r.x1 = r.x0 + (int)(rnd() % 120) - 10;
+        r.y0 = (int)(rnd() % 300) - 20; r.y1 = r.y0 + (int)(rnd() % 80) - 10;
+        epd4g_mask_clear(m1); epd4g_mask_clear(m2);
+        epd4g_mask_set_rect(m1, &r);
+        for (int y = r.y0; y <= r.y1; y++) for (int x = r.x0; x <= r.x1; x++) epd4g_mask_set(m2, x, y);
+        if (memcmp(m1, m2, sizeof m1) != 0) { CHECK(0, "mask_set_rect differs for %d,%d..%d,%d", r.x0, r.y0, r.x1, r.y1); break; }
+    }
+    random_fb(g4);
+    epd4g_fb_to_bw(bw, g4);
+    for (int y = 0; y < NAT_H; y++) for (int x = 0; x < NAT_W; x++)
+        if (epd4g_bw_fb_get(bw, x, y) != (epd4g_fb_get(g4, x, y) >= EPD4G_BW_THRESHOLD)) { CHECK(0, "fb_to_bw differs at %d,%d", x, y); return; }
+}
+
+int main(void)
+{
+    epd4g_set_partials_before_full(0, 0);   /* the ink / RAM models below check every partial update; promotion has its own tests */
+    test_init_matches_stock();
+    test_full_deep_matches_stock();
+    test_full_fast();
+    test_partial_random();
+    test_partial_diff();
+    test_power_and_sleep();
+    test_errors();
+    test_fb_helpers();
+    test_gray_skip_pass2();
+    test_bw_init_and_full_match_stock();
+    test_bw_partial();
+    test_bw_cursor_walk();
+    test_bw_modes_and_errors();
+    test_async();
+    test_wait_hint();
+    test_noop_jobs();
+    test_auto_full_gray();
+    test_auto_full_bw();
+    test_fb_fast_helpers();
+#if EPD4G_AUTO_POWEROFF_MS > 0 && EPD4G_KEEP_POWER
+    test_auto_poweroff();
+#endif
+    printf("epd4g host tests: %d display updates simulated, %s (%d failure%s)\n",
+           updates_seen, errors ? "FAILED" : "all passed", errors, errors == 1 ? "" : "s");
+    return errors ? 1 : 0;
+}
diff --git a/third_party/epd4g/tests/tools/gen_golden.c b/third_party/epd4g/tests/tools/gen_golden.c
new file mode 100644
index 0000000..e93892c
--- /dev/null
+++ b/third_party/epd4g/tests/tools/gen_golden.c
@@ -0,0 +1,85 @@
+/*
+ * Generates golden.inc: what the STOCK Waveshare library sends for Init_4GRAY, the 4-gray full
+ * display of a fixed pseudo-random image, and Sleep. test_epd4g compares the epd4g library
+ * against these values, so the library stays byte-compatible with the vendor sequence.
+ *
+ * Needs the Waveshare sources (https://github.com/waveshareteam/e-Paper):
+ *   gcc -std=gnu11 -Istub -I<e-Paper>/STM32/STM32-F103ZET6/User/e-Paper tools/gen_golden.c \
+ *       <e-Paper>/STM32/STM32-F103ZET6/User/e-Paper/EPD_2in7_V2.c -o gen_golden && ./gen_golden > golden.inc
+ */
+#include <stdio.h>
+#include <string.h>
+#include "EPD_2in7_V2.h"
+
+static int dc, cs = 1;
+static uint16_t stream[4096]; static int n;
+static uint8_t p24[5808], p26[5808]; static int n24, n26, cur_cmd = -1;
+
+void DEV_Digital_Write(UWORD pin, UBYTE v) { if (pin == EPD_DC_PIN) dc = v; else if (pin == EPD_CS_PIN) cs = v; }
+UBYTE DEV_Digital_Read(UWORD pin) { (void)pin; return 0; }
+void DEV_Delay_ms(UDOUBLE ms) { (void)ms; }
+static void byte(UBYTE v)
+{
+    if (cs) return;
+    if (!dc) { cur_cmd = v; if (v == 0x24) n24 = 0; if (v == 0x26) n26 = 0; }
+    else if (cur_cmd == 0x24 && n24 < 5808) p24[n24++] = v;
+    else if (cur_cmd == 0x26 && n26 < 5808) p26[n26++] = v;
+    if (n < 4096) stream[n++] = (uint16_t)(v | (dc ? 0x100 : 0));
+}
+void DEV_SPI_WriteByte(UBYTE v) { byte(v); }
+void DEV_SPI_Write_nByte(UBYTE *p, UDOUBLE len) { while (len--) byte(*p++); }
+
+static uint32_t fnv(const uint8_t *p, int len) { uint32_t h = 2166136261u; while (len--) { h ^= *p++; h *= 16777619u; } return h; }
+
+int main(void)
+{
+    static uint8_t img[11616];
+    uint32_t s = 12345;
+    for (int i = 0; i < 11616; i++) { s = s * 1103515245u + 12345u; img[i] = (uint8_t)(s >> 16); }
+
+    n = 0; EPD_2IN7_V2_Init_4GRAY();
+    printf("/* generated by tools/gen_golden.c from the stock Waveshare library - do not edit */\n");
+    printf("/* Init_4GRAY: bit 8 set = data byte, clear = command */\nstatic const uint16_t golden_init[] = {");
+    for (int i = 0; i < n; i++) printf("%s0x%03X,", i % 12 ? " " : "\n    ", stream[i]);
+    printf("\n};\n#define GOLDEN_IMAGE_SEED 12345u\n");
+
+    EPD_2IN7_V2_4GrayDisplay(img);
+    printf("#define GOLDEN_PLANE24_LEN %d\n#define GOLDEN_PLANE24_FNV 0x%08Xu\n", n24, fnv(p24, n24));
+    printf("#define GOLDEN_PLANE26_LEN %d\n#define GOLDEN_PLANE26_FNV 0x%08Xu\n", n26, fnv(p26, n26));
+
+    /* ---- 1-bit mode ---- */
+    static uint8_t bw[5808], win[5808];
+    s = 777;
+    for (int i = 0; i < 5808; i++) { s = s * 1103515245u + 12345u; bw[i] = (uint8_t)(s >> 16); }
+    printf("#define GOLDEN_BW_SEED 777u\n");
+
+    n = 0; EPD_2IN7_V2_Init();
+    printf("static const uint16_t golden_bw_init[] = {");
+    for (int i = 0; i < n; i++) printf(" 0x%03X,", stream[i]);
+    printf(" };\n");
+    n = 0; EPD_2IN7_V2_Init_Fast();
+    printf("static const uint16_t golden_bw_init_fast[] = {");
+    for (int i = 0; i < n; i++) printf(" 0x%03X,", stream[i]);
+    printf(" };\n");
+
+    n = 0; n24 = n26 = 0; EPD_2IN7_V2_Display_Base(bw);
+    printf("#define GOLDEN_BWBASE_P24_FNV 0x%08Xu\n#define GOLDEN_BWBASE_P26_FNV 0x%08Xu\n", fnv(p24, n24), fnv(p26, n26));
+    printf("#define GOLDEN_BWBASE_LEN %d\n", n24);
+    n = 0; n24 = n26 = 0; EPD_2IN7_V2_Display_Fast(bw);
+    printf("#define GOLDEN_BWFAST_P24_FNV 0x%08Xu\n", fnv(p24, n24));
+    n = 0; n24 = n26 = 0; EPD_2IN7_V2_Clear();
+    printf("#define GOLDEN_BWCLEAR_P24_FNV 0x%08Xu\n", fnv(p24, n24));
+
+    /* partial window: pixels x 16..87, rows 40..99 (the stock call takes exclusive ends and a packed window buffer) */
+    for (int y = 40; y < 100; y++) memcpy(&win[(y - 40) * 9], &bw[y * 22 + 2], 9);
+    n = 0; EPD_2IN7_V2_Display_Partial(win, 16, 40, 88, 100);
+    {   uint32_t h = 2166136261u;
+        for (int i = 0; i < n; i++) { h ^= stream[i] & 0xFF; h *= 16777619u; h ^= stream[i] >> 8; h *= 16777619u; }
+        printf("#define GOLDEN_BWPART_LEN %d\n#define GOLDEN_BWPART_FNV 0x%08Xu\n", n, h); }
+
+    n = 0; EPD_2IN7_V2_Sleep();
+    printf("static const uint16_t golden_sleep[] = {");
+    for (int i = 0; i < n; i++) printf(" 0x%03X,", stream[i]);
+    printf(" };\n");
+    return 0;
+}
