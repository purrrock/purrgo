index 0000000..70a6592
--- /dev/null
+++ b/third_party/epd4g/include/epd4g.h
@@ -0,0 +1,255 @@
+/**
+ * @file epd4g.h
+ * @brief Partial and fast full refresh in the 4-gray mode of the Waveshare
+ *        2.7" e-Paper HAT (V2), 264x176.
+ *
+ * The vendor library can refresh a part of the screen only in 1-bit mode. This
+ * library does it in 4 grays: pixels outside the update mask get zero drive, so the
+ * rest of the screen does not flash. Pixel-exact masks are supported.
+ *
+ * Typical use (see README.md):
+ * @code
+ *   static uint8_t fb[EPD4G_FB_BYTES], prev[EPD4G_FB_BYTES];
+ *   epd4g_init();
+ *   draw_everything(fb);
+ *   epd4g_full(fb, EPD4G_FULL_DEEP);                 // clean first picture
+ *   memcpy(prev, fb, sizeof fb);
+ *   for (;;) {
+ *       change_a_few_pixels(fb);
+ *       epd4g_partial_diff(prev, fb, NULL, NULL);    // ~1.3 s, no full-screen flash
+ *       memcpy(prev, fb, sizeof fb);
+ *   }
+ * @endcode
+ *
+ * Two ways to call the library (both drive the same state machine):
+ *
+ *   blocking      epd4g_init(), epd4g_full(), epd4g_partial(), ... return when the panel
+ *                 is done (partial ~1.3 s, full ~2.9 s with the default configuration).
+ *
+ *   non-blocking  epd4g_start_xxx() only queues the job and returns at once; call
+ *                 epd4g_poll() from the main loop until it returns 0. One poll call takes
+ *                 about a millisecond at most (EPD4G_ROWS_PER_POLL rows of SPI data, or one
+ *                 BUSY / timer check), so GNSS parsing, buttons etc. keep running while the
+ *                 panel is drawing. The buffers passed to a start function must stay
+ *                 unchanged until the job is finished.
+ *
+ * Besides the 4-gray mode this library has a 1-bit (black/white) mode with its own fast
+ * partial refresh, see epd4g_bw.h. The two modes share the panel and the state machine;
+ * epd4g_init() / epd4g_bw_init() switch between them.
+ *
+ * Not re-entrant and not thread-safe: call everything from one context (not from an ISR).
+ */
+#ifndef EPD4G_H
+#define EPD4G_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include "epd4g_config.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ----------------------------- geometry --------------------------------- */
+/** Native (portrait) panel size in pixels. Use epd4g_fb.h for rotated coordinates. */
+#define EPD4G_WIDTH         176
+#define EPD4G_HEIGHT        264
+
+/** Frame buffer: 2 bits per pixel, 4 pixels per byte, first pixel in the top 2 bits,
+ *  44 bytes per row, 264 rows, 11616 bytes. Same format as the Waveshare 4-gray buffer. */
+#define EPD4G_FB_STRIDE     (EPD4G_WIDTH / 4)
+#define EPD4G_FB_BYTES      (EPD4G_FB_STRIDE * EPD4G_HEIGHT)
+
+/** Update mask: 1 bit per pixel, MSB first, 22 bytes per row, 5808 bytes. 1 = update. */
+#define EPD4G_MASK_STRIDE   (EPD4G_WIDTH / 8)
+#define EPD4G_MASK_BYTES    (EPD4G_MASK_STRIDE * EPD4G_HEIGHT)
+
+/* ------------------------------ levels ---------------------------------- */
+/** 2-bit pixel values of the frame buffer. */
+enum {
+    EPD4G_BLACK = 0,   /**< 00 */
+    EPD4G_DARK  = 1,   /**< 01 dark gray  */
+    EPD4G_LIGHT = 2,   /**< 10 light gray */
+    EPD4G_WHITE = 3    /**< 11 */
+};
+
+/* ------------------------------ status ---------------------------------- */
+enum {
+    EPD4G_OK            =  0,
+    EPD4G_ERR_TIMEOUT   = -1,  /**< BUSY did not fall within EPD4G_BUSY_TIMEOUT_MS; call epd4g_init() again */
+    EPD4G_ERR_NOT_INIT  = -2,  /**< epd4g_init() was not called (or the panel is asleep / timed out) */
+    EPD4G_ERR_PARAM     = -3,  /**< NULL pointer or empty rectangle */
+    EPD4G_ERR_IO        = -4,  /**< epd4g_port_spi_write() failed */
+    EPD4G_ERR_BUSY      = -5,  /**< another job is still running (non-blocking API) */
+    EPD4G_ERR_MODE      = -6,  /**< the panel is initialised in the other mode (4-gray vs 1-bit), or the
+                                    fast 1-bit LUT is no longer loaded: call the matching init first */
+    EPD4G_ERR_NO_BASE   = -7   /**< 1-bit partial needs a previous epd4g_bw_full() after epd4g_bw_init() */
+};
+
+/** Returned by epd4g_poll() (not an error): the job is still running, call again. */
+#define EPD4G_PENDING   1
+
+typedef enum {
+    EPD4G_FULL_FAST = 0,  /**< shortened shake group (EPD4G_FULL_SHAKE_*): ~2.9 s with defaults */
+    EPD4G_FULL_DEEP = 1   /**< stock Waveshare 262-frame waveform: ~5.3 s, best ghost removal   */
+} epd4g_full_mode_t;
+
+/** Inclusive pixel rectangle in native panel coordinates (x 0..175, y 0..263). */
+typedef struct {
+    int x0, y0, x1, y1;
+} epd4g_rect_t;
+
+/* ------------------------------- API ------------------------------------ */
+
+/** Hardware reset and register setup (identical to the stock Init_4GRAY sequence). Also the way
+ *  to switch from the 1-bit mode back to 4 gray; follow it by epd4g_full().
+ *  Call once at start and after epd4g_sleep() or a timeout. */
+int epd4g_init(void);
+
+/** Full refresh of the whole panel from @p fb (the screen flashes).
+ *  Requires epd4g_init(). */
+int epd4g_full(const uint8_t *fb, epd4g_full_mode_t mode);
+
+/** Partial refresh: only the pixels set in @p mask are redrawn, taking their target
+ *  grays from @p fb. Pixels with a 0 mask bit must hold on the panel what @p fb
+ *  holds for them. Requires a previous epd4g_full() so that the panel content is known.
+ *  If no masked pixel is gray (only black and white) the second pass is skipped (saves ~0.2 s).
+ *
+ *  Automatic full refresh: after EPD4G_PARTIALS_BEFORE_FULL (default 10) partial updates in a row the
+ *  next request is carried out as a full refresh of @p fb (EPD4G_AUTO_FULL_MODE) instead: the result is
+ *  the same picture, but the whole screen flashes and it takes ~3 s. See epd4g_full_due(). */
+int epd4g_partial(const uint8_t *fb, const uint8_t *mask);
+
+#if EPD4G_INTERNAL_MASK
+/* The helpers below live in epd4g_fb.c and share one internal 5808-byte mask buffer, which a
+ * running (non-blocking) job keeps in use: the start functions return EPD4G_ERR_BUSY meanwhile. */
+
+/* Every start function checks its arguments and the state first and builds the mask afterwards. */
+
+/** Partial refresh of a rectangle (native coordinates, inclusive). Pixels of the rectangle that did
+ *  not change are driven again too; prefer epd4g_partial_diff() when a previous frame is available. */
+int epd4g_partial_rect(const uint8_t *fb, const epd4g_rect_t *rect);
+
+/** Convenience: compare @p prev (what is on the panel) with @p cur (what should be there),
+ *  redraw exactly the pixels that differ. @p roi limits the comparison to a rectangle
+ *  (NULL = whole panel). @p changed (optional) receives the number of differing pixels;
+ *  if there are none the panel is not touched and 0 is returned. */
+int epd4g_partial_diff(const uint8_t *prev, const uint8_t *cur,
+                       const epd4g_rect_t *roi, uint32_t *changed);
+
+/** Non-blocking twins. If epd4g_start_partial_diff() reports *changed == 0 the panel is not touched:
+ *  a no-op job is queued (see epd4g_start_noop()) that finishes in the next epd4g_poll() with
+ *  EPD4G_OK and calls the done callback, so a callback-driven update chain never stalls.
+ *  @p cur must stay unchanged until the job is finished; @p prev is only read inside the call. */
+int epd4g_start_partial_rect(const uint8_t *fb, const epd4g_rect_t *rect);
+int epd4g_start_partial_diff(const uint8_t *prev, const uint8_t *cur,
+                             const epd4g_rect_t *roi, uint32_t *changed);
+#endif
+
+/* ------------------------- non-blocking interface ------------------------- *
+ * Every epd4g_start_xxx() has the same arguments and checks as its blocking twin. It returns
+ * EPD4G_OK when the job was queued (progress it with epd4g_poll()), or an error code
+ * (EPD4G_ERR_BUSY if a job is already running, EPD4G_ERR_PARAM, EPD4G_ERR_NOT_INIT,
+ * EPD4G_ERR_MODE, ...) and then nothing was started. Only one job runs at a time. */
+int epd4g_start_init(void);
+int epd4g_start_full(const uint8_t *fb, epd4g_full_mode_t mode);
+int epd4g_start_partial(const uint8_t *fb, const uint8_t *mask);
+int epd4g_start_power_off(void);
+int epd4g_start_sleep(void);
+
+/** A job that does nothing: it finishes with EPD4G_OK in the next epd4g_poll() (the done callback is
+ *  called). Used by the library when there is nothing to send (no changed pixels, panel already
+ *  powered off / asleep); applications can use it to keep one uniform job flow. */
+int epd4g_start_noop(void);
+
+/** Status the 4-gray start functions would return for the current panel state: EPD4G_OK,
+ *  EPD4G_ERR_NOT_INIT or EPD4G_ERR_MODE (the panel is in 1-bit mode). Does not touch the panel. */
+int epd4g_gray_ready(void);
+
+/** Advance the running job. Returns EPD4G_PENDING (1) while it is still running and 0 when no
+ *  job is running (finished or none). Call it often (every main-loop pass); it never blocks,
+ *  a call takes about a millisecond at most. The outcome of a finished job is epd4g_result(). */
+int epd4g_poll(void);
+
+/** Returned by epd4g_wait_hint() when nothing is pending: no job and no automatic power-off to wait for. */
+#define EPD4G_WAIT_FOREVER 0xFFFFFFFFu
+
+/** For low-power callers: how long the application may leave the MCU asleep before the next
+ *  epd4g_poll() is useful. Call it right after epd4g_poll() (or after a start function).
+ *  Returns
+ *    0                   poll again now (SPI data is being sent, a wait is over, or the state is unknown);
+ *    EPD4G_WAIT_FOREVER  nothing to do: no job and no automatic power-off pending;
+ *    N > 0               the next poll can only make progress after N ms (a timer wait, the BUSY timeout
+ *                        or the automatic power-off delay).
+ *  *on_busy (may be NULL) is set to 1 when the job waits for the BUSY pin: then N is the BUSY timeout
+ *  and the application may also wake up on the falling edge of BUSY (BUSY = 1 means busy). With the
+ *  edge wake the settle pause after BUSY (EPD4G_BUSY_SETTLE_MS) is reported by the next call as a timer
+ *  wait. Waking earlier than N is always harmless, only waking later is not. */
+uint32_t epd4g_wait_hint(int *on_busy);
+
+/** 1 while a job is running (between a successful start and the poll that returned 0). */
+int epd4g_is_busy(void);
+
+/** 1 while the running job may still read the buffers given to its start function (frame, mask,
+ *  image). It drops to 0 as soon as the last RAM data is sent, long before the job ends (the panel
+ *  waveform takes 0.3 .. 2.5 s): from then on the caller may draw the next frame into the same
+ *  buffer, but a new epd4g_start_xxx() still returns EPD4G_ERR_BUSY until epd4g_is_busy() is 0. */
+int epd4g_data_busy(void);
+
+/** Status code of the last finished job (EPD4G_OK or an error). */
+int epd4g_result(void);
+
+/* ---------------------- full refresh after N partial updates --------------------- */
+
+/** Number of partial updates (4-gray or 1-bit) since the last full refresh. */
+unsigned epd4g_partials_since_full(void);
+
+/** 1 if the limit is reached, i.e. the next partial request will be carried out as a full refresh.
+ *  Lets the application choose a convenient moment (or call epd4g_full() itself). */
+int epd4g_full_due(void);
+
+/** Change the limits at run time (defaults: EPD4G_PARTIALS_BEFORE_FULL / EPD4G_BW_PARTIALS_BEFORE_FULL).
+ *  0 = never promote a partial update to a full refresh in that mode. */
+void epd4g_set_partials_before_full(unsigned gray, unsigned bw);
+
+/** Optional: called from epd4g_poll() when a job has finished, with its status code. The
+ *  callback may start the next job. Pass NULL to remove it. */
+typedef void (*epd4g_done_cb_t)(int rc, void *ctx);
+void epd4g_set_done_cb(epd4g_done_cb_t cb, void *ctx);
+
+/** Blocking helper: poll until the running job is finished (sleeping EPD4G_BUSY_POLL_MS between
+ *  BUSY checks through epd4g_port_delay_ms()) and return its status. */
+int epd4g_wait(void);
+
+/** Forget the running job without waiting for the panel. The panel is then considered
+ *  uninitialised: call epd4g_init() / epd4g_bw_init() before the next update. */
+void epd4g_abort(void);
+
+/** Power the panel's analog part down. Only needed with EPD4G_KEEP_POWER=1 when the
+ *  display goes idle (by default epd4g_poll() does it after EPD4G_AUTO_POWEROFF_MS of idle time); the next update
+ *  powers it up again (adds ~300 ms once). If the analog part is already off nothing is sent. */
+int epd4g_power_off(void);
+
+/** Power down and enter deep sleep (lowest consumption), from either mode.
+ *  Call epd4g_init() / epd4g_bw_init() to wake up. */
+int epd4g_sleep(void);
+
+#ifdef EPD4G_PROFILE
+/** Phase durations of the last update, ms (wall time, includes time the main loop spent elsewhere
+ *  when the non-blocking API is used). A full refresh fills setup/spi1/wait1 only; a partial
+ *  update without gray pixels skips pass 2 (spi2 = wait2 = 0). */
+typedef struct {
+    uint16_t setup;    /**< registers + LUT of pass 1            */
+    uint16_t spi1;     /**< RAM planes of pass 1                 */
+    uint16_t wait1;    /**< 0x20 -> BUSY low: waveform of pass 1 */
+    uint16_t spi2;     /**< LUT + RAM planes of pass 2           */
+    uint16_t wait2;    /**< waveform of pass 2                   */
+} epd4g_profile_t;
+const epd4g_profile_t *epd4g_get_profile(void);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EPD4G_H */
diff --git a/third_party/epd4g/include/epd4g_bw.h b/third_party/epd4g/include/epd4g_bw.h
new file mode 100644
index 0000000..365675f
--- /dev/null
+++ b/third_party/epd4g/include/epd4g_bw.h
@@ -0,0 +1,96 @@
+/**
+ * @file epd4g_bw.h
+ * @brief 1-bit (black/white) mode of the Waveshare 2.7" e-Paper HAT V2, 264x176.
+ *
+ * Replaces the stock EPD_2in7_V2 driver: the init, fast init, full, fast full, clear, partial
+ * and sleep sequences are the stock ones (verified byte for byte by tests/ against the vendor
+ * library), with the same non-blocking state machine as the 4-gray mode (epd4g.h).
+ *
+ * Typical use:
+ * @code
+ *   epd4g_start_bw_init(EPD4G_BW_NORMAL);   // or the blocking epd4g_bw_init()
+ *   ... poll until done ...
+ *   epd4g_start_bw_full(img, EPD4G_SRC_2BPP, EPD4G_BW_NORMAL);   // baseline picture, flashes
+ *   ... poll until done ...
+ *   epd4g_start_bw_partial(img, EPD4G_SRC_2BPP, &rect);          // ~0.3-0.5 s, only that window
+ * @endcode
+ *
+ * The panel keeps the old and the new picture in two RAM planes and compares them itself, so
+ * no copy of the previous frame is needed on the MCU. A partial update draws the window rows
+ * of the image you pass; everything outside the window is untouched.
+ *
+ * Sleep: epd4g_sleep() in the 1-bit mode keeps the RAM planes. The stock flow "Init + Display_Base +
+ * Sleep ... Display_Partial + Sleep" therefore works: epd4g_bw_partial() wakes the panel with its
+ * hardware reset (EPD4G_BW_PARTIAL_RESET=1). A full refresh after sleep needs epd4g_bw_init() first.
+ *
+ * Mode switching: epd4g_init() (4 gray) and epd4g_bw_init() both reset the panel. After either
+ * of them the first update must be a full one (epd4g_full() / epd4g_bw_full()).
+ */
+#ifndef EPD4G_BW_H
+#define EPD4G_BW_H
+
+#include "epd4g.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** 1-bit frame buffer: 1 bit per pixel, MSB first, 1 = white, 0 = black, 22 bytes per row,
+ *  264 rows, 5808 bytes (the stock Waveshare format, native portrait orientation). */
+#define EPD4G_BW_STRIDE     (EPD4G_WIDTH / 8)
+#define EPD4G_BW_FB_BYTES   (EPD4G_BW_STRIDE * EPD4G_HEIGHT)
+#define EPD4G_BW_BLACK      0
+#define EPD4G_BW_WHITE      1
+
+/** Format of the image passed to the 1-bit update functions. */
+typedef enum {
+    EPD4G_SRC_1BPP  = 0,   /**< EPD4G_BW_FB_BYTES buffer, see above                                  */
+    EPD4G_SRC_2BPP  = 1,   /**< a 4-gray frame buffer (EPD4G_FB_BYTES), converted row by row while
+                                it is sent: pixel >= EPD4G_BW_THRESHOLD -> white. No extra buffer.  */
+    EPD4G_SRC_WHITE = 2    /**< all white, the image pointer is ignored (may be NULL)                */
+} epd4g_src_t;
+
+typedef enum {
+    EPD4G_BW_NORMAL = 0,   /**< stock Init / Display: temperature-compensated OTP waveform, ~2 s     */
+    EPD4G_BW_FAST   = 1    /**< stock Init_Fast / Display_Fast: shorter waveform, ~1 s               */
+} epd4g_bw_mode_t;
+
+/* ----------------------------- blocking API ------------------------------- */
+
+/** Reset and register setup (stock EPD_2IN7_V2_Init, or _Init_Fast for EPD4G_BW_FAST).
+ *  Switches the panel to 1-bit mode. */
+int epd4g_bw_init(epd4g_bw_mode_t mode);
+
+/** Full refresh from @p img, written to both RAM planes (stock Display_Base). EPD4G_BW_FAST needs
+ *  epd4g_bw_init(EPD4G_BW_FAST) and no partial update since (a partial update loads another
+ *  waveform): otherwise EPD4G_ERR_MODE. */
+int epd4g_bw_full(const void *img, epd4g_src_t src, epd4g_bw_mode_t mode);
+
+/** Full refresh to white (stock Clear). */
+int epd4g_bw_clear(epd4g_bw_mode_t mode);
+
+/** After EPD4G_BW_PARTIALS_BEFORE_FULL (default 10) partial updates in a row the request is carried out
+ *  as a full refresh (EPD4G_BW_NORMAL) of the same frame instead; after deep sleep the library runs
+ *  epd4g_bw_init() first. See epd4g_full_due().
+ *
+ *  Partial refresh of @p rect (native coordinates, inclusive; x is widened to whole bytes, i.e.
+ *  8 pixel columns; NULL = whole screen). The rows of @p img inside the window are sent, so
+ *  @p img is a full-screen frame. Needs a previous epd4g_bw_full() after epd4g_bw_init(),
+ *  otherwise EPD4G_ERR_NO_BASE. */
+int epd4g_bw_partial(const void *img, epd4g_src_t src, const epd4g_rect_t *rect);
+
+/* --------------------------- non-blocking API ---------------------------- */
+/* Same arguments and checks as above; see epd4g.h (epd4g_poll(), epd4g_result(), ...).
+ * @p img must stay unchanged until the job is finished. */
+int epd4g_start_bw_init(epd4g_bw_mode_t mode);
+int epd4g_start_bw_full(const void *img, epd4g_src_t src, epd4g_bw_mode_t mode);
+int epd4g_start_bw_clear(epd4g_bw_mode_t mode);
+int epd4g_start_bw_partial(const void *img, epd4g_src_t src, const epd4g_rect_t *rect);
+
+/* Deep sleep and power-off work in both modes: epd4g_sleep(), epd4g_power_off() (epd4g.h). */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EPD4G_BW_H */
diff --git a/third_party/epd4g/include/epd4g_config.h b/third_party/epd4g/include/epd4g_config.h
new file mode 100644
index 0000000..0cd4970
--- /dev/null
+++ b/third_party/epd4g/include/epd4g_config.h
@@ -0,0 +1,197 @@
+/**
+ * @file epd4g_config.h
+ * @brief Compile-time configuration of the epd4g library.
+ *
+ * Every macro can be overridden in three ways (first one wins):
+ *   1. -DNAME=value on the compiler command line / in target_compile_definitions();
+ *   2. a project header: compile with -DEPD4G_USER_CONFIG="my_epd4g_cfg.h";
+ *   3. edit the default below (not recommended for a git submodule).
+ */
+#ifndef EPD4G_CONFIG_H
+#define EPD4G_CONFIG_H
+
+#ifdef EPD4G_USER_CONFIG
+#include EPD4G_USER_CONFIG
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * Partial update waveform, in panel frames (1 frame = 20 ms at the stock
+ * frame rate). A partial update is two passes:
+ *   pass 1: black pixels get VSH for EPD4G_T_BLACK frames, every other updated
+ *           pixel gets VSL for EPD4G_T_WHITE frames (saturates to white);
+ *   pass 2: light / dark gray pixels get VSH for EPD4G_T_LIGHT / EPD4G_T_DARK frames.
+ * Duration = max(T_WHITE, T_BLACK) + T_DARK frames  (45 + 4 = 49 -> ~0.98 s of waveform,
+ * plus ~0.13 s of fixed overhead per 0x20 command and the SPI transfers).
+ * ------------------------------------------------------------------------- */
+#ifndef EPD4G_T_LIGHT
+#define EPD4G_T_LIGHT   1    /**< light gray: VSH after the erase (stock 3; fewer frames = lighter) */
+#endif
+#ifndef EPD4G_T_DARK
+#define EPD4G_T_DARK    4    /**< dark gray: cumulative VSH after the erase (stock 8, >= LIGHT)     */
+#endif
+/* The same two grays in the full refresh (stock LUT: 3 and 8 frames). By default they follow
+ * the partial-update values, so the background drawn by a full refresh and the pixels redrawn
+ * by a partial one look identical. Define them separately only to tune the two independently. */
+#ifndef EPD4G_FULL_T_LIGHT
+#define EPD4G_FULL_T_LIGHT  EPD4G_T_LIGHT
+#endif
+#ifndef EPD4G_FULL_T_DARK
+#define EPD4G_FULL_T_DARK   EPD4G_T_DARK
+#endif
+#ifndef EPD4G_T_BLACK
+#define EPD4G_T_BLACK   45   /**< black: VSH that saturates a pixel to black. 25 (stock) under-drives black */
+#endif
+#ifndef EPD4G_T_WHITE
+#define EPD4G_T_WHITE   40   /**< white: VSL that saturates a pixel to white from any state */
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * Full refresh, EPD4G_FULL_FAST mode. The stock 262-frame waveform (used by
+ * EPD4G_FULL_DEEP) has a "shake" group of VSH/VSL pulses of TP frames, repeated
+ * RP+1 times. Fewer repeats = faster, weaker ghost removal.
+ *   RP=3  stock, 262 frames (~5.2 s)      RP=1  178 frames (~3.6 s)
+ *   RP=0  136 frames (~2.7 s), default
+ * ------------------------------------------------------------------------- */
+#ifndef EPD4G_FULL_SHAKE_RP
+#define EPD4G_FULL_SHAKE_RP  0
+#endif
+#ifndef EPD4G_FULL_SHAKE_TP
+#define EPD4G_FULL_SHAKE_TP  20
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * Power management.
+ * 1 = after an update the panel's analog part stays on (0x22=0xC4). Saves ~330 ms
+ *     per power-up/power-down cycle; call epd4g_power_off() when going idle.
+ * 0 = every update powers the analog part up and down (0x22=0xC7, safe default
+ *     for rarely updated displays, but ~330 ms slower per pass).
+ * ------------------------------------------------------------------------- */
+#ifndef EPD4G_KEEP_POWER
+#define EPD4G_KEEP_POWER 1
+#endif
+
+/** Automatic power-off of the analog part (EPD4G_KEEP_POWER=1 or EPD4G_BW_KEEP_POWER=1).
+ *  N > 0 (default 500) = epd4g_poll() starts a power-off job by itself when the panel has been idle for N ms
+ *  while its analog part is still on (the panel must not stay in the high-voltage state for long).
+ *  Needs epd4g_poll() to be called from the main loop (the blocking API alone never polls while idle:
+ *  such an application must call epd4g_power_off() / epd4g_sleep() itself).
+ *  0 = off: the application is fully responsible for epd4g_power_off() / epd4g_sleep().
+ *  Updates that follow each other within N ms keep the analog part on (no ~0.3 s power-up penalty).
+ *  The automatic job is silent (no done callback, epd4g_result() is not touched) but it is a
+ *  normal job: epd4g_is_busy() is 1 for ~0.3 s and a start function returns EPD4G_ERR_BUSY meanwhile. */
+#ifndef EPD4G_AUTO_POWEROFF_MS
+#define EPD4G_AUTO_POWEROFF_MS 500
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * Automatic full refresh. Partial updates leave traces that only a full refresh removes; the
+ * library counts partial updates and, when the limit is reached, performs the next partial request
+ * as a full refresh of the same frame (the picture is exactly the requested one, but the whole
+ * screen flashes and it takes ~3 s). 0 = never (the application decides, see epd4g_full_due()).
+ * One counter for both modes; any full refresh (4-gray or 1-bit) resets it.
+ * Run time override: epd4g_set_partials_before_full().
+ * ------------------------------------------------------------------------- */
+#ifndef EPD4G_PARTIALS_BEFORE_FULL
+#define EPD4G_PARTIALS_BEFORE_FULL    10   /**< 4-gray: the 11th partial request becomes a full refresh */
+#endif
+#ifndef EPD4G_BW_PARTIALS_BEFORE_FULL
+#define EPD4G_BW_PARTIALS_BEFORE_FULL EPD4G_PARTIALS_BEFORE_FULL   /**< 1-bit mode */
+#endif
+/** 4-gray full refresh mode used for the automatic one (the 1-bit mode always uses EPD4G_BW_NORMAL,
+ *  which also works after deep sleep: the library runs epd4g_bw_init() first if needed). */
+#ifndef EPD4G_AUTO_FULL_MODE
+#define EPD4G_AUTO_FULL_MODE   EPD4G_FULL_FAST
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * BUSY handling
+ * ------------------------------------------------------------------------- */
+#ifndef EPD4G_BUSY_TIMEOUT_MS
+#define EPD4G_BUSY_TIMEOUT_MS  10000U   /**< a stuck panel returns EPD4G_ERR_TIMEOUT instead of hanging */
+#endif
+#ifndef EPD4G_BUSY_POLL_MS
+#define EPD4G_BUSY_POLL_MS     1U       /**< epd4g_port_delay_ms() between BUSY reads (RTOS yield point) */
+#endif
+#ifndef EPD4G_BUSY_SETTLE_MS
+#define EPD4G_BUSY_SETTLE_MS   2U       /**< pause after BUSY falls (stock Waveshare code uses 20) */
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * Non-blocking operation
+ * ------------------------------------------------------------------------- */
+/** Rows of RAM data (22 or 44 bytes each) sent per epd4g_poll() call. One row takes ~0.1 ms with
+ *  HAL polling SPI at 8 MHz, so 8 rows ~ 1 ms. Lower = more responsive main loop, higher = fewer polls. */
+#ifndef EPD4G_ROWS_PER_POLL
+#define EPD4G_ROWS_PER_POLL  8
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * 1-bit (black/white) mode, see epd4g_bw.h. The defaults reproduce the stock Waveshare
+ * sequence exactly (OTP waveforms, hardware reset before every partial update).
+ * ------------------------------------------------------------------------- */
+/** Level at which a 2-bit pixel becomes white when a 4-gray frame is used as 1-bit source
+ *  (EPD4G_SRC_2BPP): pixel value >= threshold -> white. 2 = light gray and white are white. */
+#ifndef EPD4G_BW_THRESHOLD
+#define EPD4G_BW_THRESHOLD   2
+#endif
+
+/** 1 = hardware reset before every 1-bit partial update, as the stock Display_Partial() does
+ *  (~42 ms). 0 = skip it (faster, NOT verified on hardware). */
+#ifndef EPD4G_BW_PARTIAL_RESET
+#define EPD4G_BW_PARTIAL_RESET 1
+#endif
+
+/** 1 = after every 1-bit partial update, once the waveform has finished, the same window is written to
+ *  RAM 0x24 a second time (the image buffer is read again, so epd4g_data_busy() stays 1 until that is done).
+ *
+ *  Why: a partial update drives the pixels whose "new" and "old" RAM differ, and on the real panel the
+ *  two RAM planes swap roles after every update (measured: the plane that 0x24 writes into is the one
+ *  that was "old" before). With only the stock Display_Partial() stream, after update n the window shows
+ *  image n together with the images n-2, n-4, ... of the unchanged rows: e.g. a menu cursor leaves
+ *  inverted rows behind on every second step. Rewriting the window into the (now swapped) 0x24 plane makes
+ *  both planes equal again, so the next partial update compares against what is really on the glass.
+ *  Harmless on a controller that does not swap (it just rewrites the plane with the same data).
+ *  0 = stock Display_Partial() stream only. */
+#ifndef EPD4G_BW_RESYNC
+#define EPD4G_BW_RESYNC 1
+#endif
+
+/** 1 = 1-bit updates leave the analog part powered (0xFC / 0xF4 / 0xC4 instead of 0xFF / 0xF7 /
+ *  0xC7), saves ~300 ms per update; call epd4g_power_off() when idle. Needs
+ *  EPD4G_BW_PARTIAL_RESET=0. NOT verified on hardware, so off by default. */
+#ifndef EPD4G_BW_KEEP_POWER
+#define EPD4G_BW_KEEP_POWER  0
+#endif
+
+/** Value of the border register (0x3C) that a 1-bit full refresh restores after a partial update
+ *  (the partial update sets 0x80). 0x05 is the controller's reset default. */
+#ifndef EPD4G_BW_BORDER_FULL
+#define EPD4G_BW_BORDER_FULL 0x05
+#endif
+
+/* ------------------------------------------------------------------------- *
+ * Optional features / diagnostics (all off by default, zero cost when off)
+ * ------------------------------------------------------------------------- */
+
+/** Define EPD4G_PROFILE to record per-phase timings: see epd4g_get_profile(). */
+/* #define EPD4G_PROFILE */
+
+/** Define EPD4G_LOG(...) as a printf-like function to get library messages
+ *  (init steps, errors). Default: no output. The definition must be self-contained,
+ *  e.g. in a user config header: #include <stdio.h>  #define EPD4G_LOG(...) printf(__VA_ARGS__) */
+#ifndef EPD4G_LOG
+#define EPD4G_LOG(...) ((void)0)
+#endif
+
+/** 1 = epd4g_partial_diff() and epd4g_partial_rect() are built (in epd4g_fb.c) and share one
+ *  static 5808-byte mask buffer. 0 = omitted: build your own mask and call epd4g_partial(). */
+#ifndef EPD4G_INTERNAL_MASK
+#define EPD4G_INTERNAL_MASK 1
+#endif
+
+/** The library forces -O2 for itself under GCC when the project is built without
+ *  optimisation (Debug, -O0): the bit conversion loops are ~10x slower at -O0.
+ *  Define EPD4G_NO_FORCE_O2 to disable that. */
+/* #define EPD4G_NO_FORCE_O2 */
+
+#endif /* EPD4G_CONFIG_H */
diff --git a/third_party/epd4g/include/epd4g_fb.h b/third_party/epd4g/include/epd4g_fb.h
new file mode 100644
index 0000000..75043d1
--- /dev/null
+++ b/third_party/epd4g/include/epd4g_fb.h
@@ -0,0 +1,75 @@
+/**
+ * @file epd4g_fb.h
+ * @brief Optional helpers: frame buffer pixels, screen rotation, update masks.
+ */
+#ifndef EPD4G_FB_H
+#define EPD4G_FB_H
+
+#include "epd4g.h"
+#include "epd4g_bw.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Screen orientation. The panel is native portrait 176x264; the other
+ *  orientations give a logical coordinate system rotated onto it. */
+typedef enum {
+    EPD4G_ROT_0   = 0,  /**< portrait, 176 x 264, connector at the top (native)        */
+    EPD4G_ROT_90  = 1,  /**< landscape, 264 x 176 (the reference project's default)     */
+    EPD4G_ROT_180 = 2,  /**< portrait upside down, 176 x 264                            */
+    EPD4G_ROT_270 = 3   /**< landscape upside down, 264 x 176                           */
+} epd4g_rot_t;
+
+/** Logical width / height for an orientation. */
+int epd4g_logical_width(epd4g_rot_t rot);
+int epd4g_logical_height(epd4g_rot_t rot);
+
+/** Logical -> native coordinates. Returns 0, or -1 if (x,y) is outside the screen. */
+int epd4g_map(epd4g_rot_t rot, int x, int y, int *nx, int *ny);
+
+/** Bounding rectangle (native) of a logical rectangle (inclusive, clipped). Returns 0, or -1 if empty. */
+int epd4g_map_rect(epd4g_rot_t rot, int x0, int y0, int x1, int y1, epd4g_rect_t *out);
+
+/** Fill the whole buffer with one level (EPD4G_BLACK..EPD4G_WHITE). */
+void epd4g_fb_fill(uint8_t *fb, uint8_t level);
+
+/** Pixel access in NATIVE coordinates; out-of-range access is ignored / returns EPD4G_WHITE. */
+void    epd4g_fb_set(uint8_t *fb, int x, int y, uint8_t level);
+uint8_t epd4g_fb_get(const uint8_t *fb, int x, int y);
+
+/** Pixel access in LOGICAL coordinates of the given orientation. */
+void    epd4g_fb_set_rot(uint8_t *fb, epd4g_rot_t rot, int x, int y, uint8_t level);
+uint8_t epd4g_fb_get_rot(const uint8_t *fb, epd4g_rot_t rot, int x, int y);
+
+/** Copy the rows of @p rect (full byte columns, so a few neighbouring pixels may be copied too)
+ *  from @p src to @p dst: restore a background under a moved sprite. */
+void epd4g_fb_copy_rect(uint8_t *dst, const uint8_t *src, const epd4g_rect_t *rect);
+
+/* ----- update masks (EPD4G_MASK_BYTES bytes, 1 bit per pixel) ----- */
+void epd4g_mask_clear(uint8_t *mask);
+void epd4g_mask_set(uint8_t *mask, int x, int y);                  /**< native coordinates */
+void epd4g_mask_set_rect(uint8_t *mask, const epd4g_rect_t *rect);
+
+/** Build a mask of the pixels that differ between @p prev and @p cur inside @p roi
+ *  (NULL = whole panel). The mask is cleared first. Returns the number of set bits. */
+uint32_t epd4g_mask_from_diff(uint8_t *mask, const uint8_t *prev, const uint8_t *cur,
+                              const epd4g_rect_t *roi);
+
+/* ----- 1-bit frame helpers (EPD4G_SRC_1BPP buffers, EPD4G_BW_FB_BYTES bytes, 1 = white) ----- */
+void epd4g_bw_fb_fill(uint8_t *fb, int white);
+void epd4g_bw_fb_set(uint8_t *fb, int x, int y, int white);        /**< native coordinates */
+int  epd4g_bw_fb_get(const uint8_t *fb, int x, int y);
+void epd4g_bw_fb_set_rot(uint8_t *fb, epd4g_rot_t rot, int x, int y, int white);   /**< logical */
+int  epd4g_bw_fb_get_rot(const uint8_t *fb, epd4g_rot_t rot, int x, int y);
+void epd4g_bw_fb_copy_rect(uint8_t *dst, const uint8_t *src, const epd4g_rect_t *rect);
+
+/** Convert a whole 4-gray frame to a 1-bit one (pixel >= EPD4G_BW_THRESHOLD -> white). Normally not
+ *  needed: pass the 4-gray frame with EPD4G_SRC_2BPP and it is converted while it is sent. */
+void epd4g_fb_to_bw(uint8_t *bw, const uint8_t *fb);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EPD4G_FB_H */
diff --git a/third_party/epd4g/include/epd4g_port.h b/third_party/epd4g/include/epd4g_port.h
new file mode 100644
index 0000000..d2fcca8
--- /dev/null
+++ b/third_party/epd4g/include/epd4g_port.h
@@ -0,0 +1,35 @@
+/**
+ * @file epd4g_port.h
+ * @brief Hardware abstraction the epd4g library needs. Implement these 7 functions
+ *        for your platform (a ready STM32 HAL port is in port/stm32_hal/).
+ *
+ * Wiring (Waveshare 2.7" HAT V2): SPI mode 0 (CPOL=0, CPHA=0), MSB first, 8 bit,
+ * TX only is enough. CS is a plain GPIO driven by the library. SPI clock <= 10 MHz
+ * is safe (the reference project runs at 8 MHz).
+ */
+#ifndef EPD4G_PORT_H
+#define EPD4G_PORT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void     epd4g_port_gpio_rst(int level);           /**< RST pin: 0 = low, 1 = high         */
+void     epd4g_port_gpio_dc(int level);            /**< D/C pin: 0 = command, 1 = data     */
+void     epd4g_port_gpio_cs(int level);            /**< CS pin (software chip select)       */
+int      epd4g_port_gpio_busy(void);               /**< BUSY pin: 1 = panel busy, 0 = ready */
+
+/** Blocking SPI transmit. Returns 0 on success, non-zero on error (-> EPD4G_ERR_IO). */
+int      epd4g_port_spi_write(const uint8_t *data, size_t len);
+
+void     epd4g_port_delay_ms(uint32_t ms);         /**< may yield to an RTOS scheduler      */
+uint32_t epd4g_port_tick_ms(void);                 /**< monotonic millisecond counter (wraps ok) */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EPD4G_PORT_H */
diff --git a/third_party/epd4g/port/stm32_hal/epd4g_port_stm32_hal.c b/third_party/epd4g/port/stm32_hal/epd4g_port_stm32_hal.c
new file mode 100644
index 0000000..73494c6
--- /dev/null
+++ b/third_party/epd4g/port/stm32_hal/epd4g_port_stm32_hal.c
@@ -0,0 +1,88 @@
+/**
+ * @file epd4g_port_stm32_hal.c
+ * @brief epd4g port for STM32 HAL (any family), software CS, blocking SPI.
+ *
+ * Defaults match the CubeMX project in this repository: SPI handle `hspi1` and GPIO
+ * labels EINK_RST / EINK_DC / EINK_CS / EINK_BUSY (CubeMX generates EINK_xxx_GPIO_Port and
+ * EINK_xxx_Pin in main.h). To use other names or pins, override any of the macros below
+ * from the build system or from a user config header (see EPD4G_USER_CONFIG).
+ *
+ * CubeMX settings: SPI Full-Duplex or Transmit-Only Master, 8 bit, MSB first, CPOL low,
+ * CPHA 1 Edge, NSS software, baud <= 10 MHz. CS/DC/RST: GPIO output, BUSY: GPIO input.
+ */
+#include "epd4g_port.h"
+#include "epd4g_config.h"
+
+#ifndef EPD4G_HAL_HEADER
+#define EPD4G_HAL_HEADER       "main.h"        /* includes the device HAL header and the pin labels */
+#endif
+#include EPD4G_HAL_HEADER
+
+#ifndef EPD4G_SPI_HANDLE
+#define EPD4G_SPI_HANDLE       hspi1
+#endif
+#ifndef EPD4G_RST_PORT
+#define EPD4G_RST_PORT         EINK_RST_GPIO_Port
+#define EPD4G_RST_PIN          EINK_RST_Pin
+#endif
+#ifndef EPD4G_DC_PORT
+#define EPD4G_DC_PORT          EINK_DC_GPIO_Port
+#define EPD4G_DC_PIN           EINK_DC_Pin
+#endif
+#ifndef EPD4G_CS_PORT
+#define EPD4G_CS_PORT          EINK_CS_GPIO_Port
+#define EPD4G_CS_PIN           EINK_CS_Pin
+#endif
+#ifndef EPD4G_BUSY_PORT
+#define EPD4G_BUSY_PORT        EINK_BUSY_GPIO_Port
+#define EPD4G_BUSY_PIN         EINK_BUSY_Pin
+#endif
+#ifndef EPD4G_SPI_TIMEOUT_MS
+/* The longest single transfer is the 153-byte LUT (~0.15 ms at 8 MHz). A short timeout keeps the main
+ * loop alive if SPI hangs: HAL_SPI_Transmit() blocks for at most this long. */
+#define EPD4G_SPI_TIMEOUT_MS   20U
+#endif
+
+extern SPI_HandleTypeDef EPD4G_SPI_HANDLE;
+
+void epd4g_port_gpio_rst(int level)
+{
+    HAL_GPIO_WritePin(EPD4G_RST_PORT, EPD4G_RST_PIN, level ? GPIO_PIN_SET : GPIO_PIN_RESET);
+}
+
+void epd4g_port_gpio_dc(int level)
+{
+    HAL_GPIO_WritePin(EPD4G_DC_PORT, EPD4G_DC_PIN, level ? GPIO_PIN_SET : GPIO_PIN_RESET);
+}
+
+void epd4g_port_gpio_cs(int level)
+{
+    HAL_GPIO_WritePin(EPD4G_CS_PORT, EPD4G_CS_PIN, level ? GPIO_PIN_SET : GPIO_PIN_RESET);
+}
+
+int epd4g_port_gpio_busy(void)
+{
+    return HAL_GPIO_ReadPin(EPD4G_BUSY_PORT, EPD4G_BUSY_PIN) == GPIO_PIN_SET;
+}
+
+int epd4g_port_spi_write(const uint8_t *data, size_t len)
+{
+    while (len > 0) {
+        uint16_t n = (len > 0xFFFFu) ? 0xFFFFu : (uint16_t)len;
+        if (HAL_SPI_Transmit(&EPD4G_SPI_HANDLE, (uint8_t *)data, n, EPD4G_SPI_TIMEOUT_MS) != HAL_OK)
+            return -1;
+        data += n;
+        len  -= n;
+    }
+    return 0;
+}
+
+void epd4g_port_delay_ms(uint32_t ms)
+{
+    HAL_Delay(ms);
+}
+
+uint32_t epd4g_port_tick_ms(void)
+{
+    return HAL_GetTick();
+}
diff --git a/third_party/epd4g/src/epd4g.c b/third_party/epd4g/src/epd4g.c
new file mode 100644
index 0000000..3804d72
--- /dev/null
+++ b/third_party/epd4g/src/epd4g.c
@@ -0,0 +1,1017 @@
+/**
+ * @file epd4g.c
+ * @brief Partial and fast full refresh in the 4-gray mode, Waveshare 2.7" e-Paper HAT V2.
+ *
+ * Why a special routine is needed
+ *   The stock 4-gray LUT is an ABSOLUTE waveform: every pixel is shaken (VSH 20 /
+ *   VSL 20 frames, x4) and then moved towards VSH by 0 / 3 / 8 / 25 frames (LUT rows
+ *   0..3). All four LUT rows are used for the four gray levels, so there is no
+ *   "do not touch this pixel" code, and the 0x20 trigger always updates the whole panel.
+ *
+ * Partial update = two passes with a custom LUT in register 0x32. LUT row 0 is empty
+ * ("keep"): pixels outside the mask are written as RAM pair (0,0).
+ *   pass 1 (max(T_WHITE,T_BLACK) frames, both at once):
+ *     masked pixel, target black             -> row 3     : VSH T_BLACK frames
+ *     masked pixel, any other target         -> rows 1, 2 : VSL T_WHITE frames
+ *   pass 2 (T_DARK frames):
+ *     masked pixel, target light / dark gray -> rows 1, 2 : VSH T_LIGHT / T_DARK frames
+ * Black and white are saturated extremes, so they do not depend on the old gray and
+ * need no erase first. Only the two intermediate grays must start from white, which
+ * pass 1 provides.
+ *
+ * The RAM bits of a pixel are exactly the bits the stock 4-gray display routine writes,
+ * so which gray lands on which LUT row is the same as in the stock waveform.
+ *
+ * Non-blocking operation: every public operation is a "job" run by a small cooperative state
+ * machine (line-number coroutine, see the CR_ macros). epd4g_poll() advances the job until it
+ * has to wait (BUSY pin, a timer) or has sent EPD4G_ROWS_PER_POLL rows of RAM data, then
+ * returns. The blocking functions are start + poll loop, so there is a single implementation.
+ *
+ * 1-bit mode: the stock EPD_2in7_V2 sequences (Init, Init_Fast, Display_Base, Display_Fast,
+ * Clear, Display_Partial, Sleep), see epd4g_bw.h.
+ *
+ * Credits: the register sequence of epd4g_init() and the stock LUT table come from the
+ * Waveshare e-Paper library (https://github.com/waveshareteam/e-Paper, MIT-style
+ * license, (c) Waveshare team); see README.md.
+ */
+#include "epd4g.h"
+#include "epd4g_bw.h"
+#include "epd4g_port.h"
+#include <string.h>
+
+/* The conversion loops are ~10x slower at -O0 (Debug builds); force -O2 for this file. */
+#if defined(__GNUC__) && !defined(__clang__) && !defined(__OPTIMIZE__) && !defined(EPD4G_NO_FORCE_O2)
+#pragma GCC optimize ("O2")
+#endif
+
+/* ---------------------- compile-time configuration checks ---------------- */
+#define EPD4G_STATIC_ASSERT(name, cond) typedef char epd4g_assert_##name[(cond) ? 1 : -1]
+EPD4G_STATIC_ASSERT(light_le_dark,  EPD4G_T_LIGHT <= EPD4G_T_DARK);
+EPD4G_STATIC_ASSERT(light_pos,      EPD4G_T_LIGHT >= 1);
+EPD4G_STATIC_ASSERT(full_gray,      EPD4G_FULL_T_LIGHT >= 1 && EPD4G_FULL_T_DARK <= 255 &&
+                                    EPD4G_FULL_T_LIGHT <= EPD4G_FULL_T_DARK);
+EPD4G_STATIC_ASSERT(times_le_255,   EPD4G_T_BLACK <= 255 && EPD4G_T_WHITE <= 255 &&
+                                    EPD4G_T_DARK <= 255 && EPD4G_FULL_SHAKE_TP <= 255 &&
+                                    EPD4G_FULL_SHAKE_RP <= 255);
+EPD4G_STATIC_ASSERT(black_white_pos, EPD4G_T_BLACK >= 1 && EPD4G_T_WHITE >= 1);
+EPD4G_STATIC_ASSERT(rows_per_poll,  EPD4G_ROWS_PER_POLL >= 1);
+EPD4G_STATIC_ASSERT(bw_threshold,   EPD4G_BW_THRESHOLD >= 1 && EPD4G_BW_THRESHOLD <= 3);
+/* keeping the analog part on is incompatible with the hardware reset before a partial update */
+EPD4G_STATIC_ASSERT(bw_keep_vs_reset, !(EPD4G_BW_KEEP_POWER && EPD4G_BW_PARTIAL_RESET));
+
+#ifdef EPD4G_PROFILE
+static epd4g_profile_t epd4g_prof;
+static uint32_t prof_t;
+const epd4g_profile_t *epd4g_get_profile(void) { return &epd4g_prof; }
+#define PROF(field)  do { epd4g_prof.field = (uint16_t)(epd4g_port_tick_ms() - prof_t); \
+                          prof_t = epd4g_port_tick_ms(); } while (0)
+#define PROF_BEGIN() do { prof_t = epd4g_port_tick_ms(); memset(&epd4g_prof, 0, sizeof epd4g_prof); } while (0)
+#else
+#define PROF(field)  do { } while (0)
+#define PROF_BEGIN() do { } while (0)
+#endif
+
+/* ----------------------------- stock LUT --------------------------------- */
+/* Waveshare LUT_DATA_4Gray: [0..152] LUT for register 0x32, then
+ * [153] EOPQ (0x3F)  [154] VGH (0x03)  [155..157] VSH1, VSH2, VSL (0x04)  [158] VCOM (0x2C). */
+static const uint8_t lut_stock[159] = {
+    0x40, 0x48, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x08, 0x48, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x02, 0x48, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x20, 0x48, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x0A, 0x19, 0x00, 0x03, 0x08, 0x00, 0x00, 0x14, 0x01, 0x00, 0x14, 0x01,
+    0x00, 0x03, 0x0A, 0x03, 0x00, 0x08, 0x19, 0x00, 0x00, 0x01, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x00, 0x00, 0x00, 0x22, 0x17, 0x41,
+    0x00, 0x32, 0x1C
+};
+
+/* ---------------------------- driver state ------------------------------- */
+enum { MODE_NONE = 0, MODE_GRAY, MODE_BW };
+enum { JOB_NONE = 0, JOB_INIT, JOB_FULL, JOB_PARTIAL, JOB_BW_INIT, JOB_BW_FULL, JOB_BW_PARTIAL,
+       JOB_POWER_OFF, JOB_SLEEP, JOB_NOP };
+
+static uint8_t s_mode;        /* MODE_xxx: set when an init job has finished, cleared by a timeout / sleep */
+static uint8_t s_io_err;      /* sticky: an SPI write failed during the current job */
+static uint8_t s_powered;     /* analog part left powered by the last update (KEEP_POWER variants) */
+static uint8_t s_base;        /* 1-bit: a full update was done since the last init (RAM planes valid) */
+static uint8_t s_win_full;    /* 1-bit: RAM window registers cover the whole panel */
+static uint8_t s_border_part; /* 1-bit: border register still holds the partial-update value */
+static uint8_t s_fast_lut;    /* 1-bit: the Init_Fast waveform is loaded (EPD4G_BW_FAST full is possible) */
+static uint8_t s_asleep;      /* 1-bit: deep sleep entered; RAM planes kept, a partial update wakes the panel by its reset */
+static uint8_t s_data;        /* the running job may still read the caller's buffers */
+static uint8_t s_waiting;     /* the last poll stopped on a timer / BUSY wait (not on a data slice) */
+static uint8_t s_wait_kind;   /* what it waits for: WAIT_KIND_* (valid while s_waiting) */
+static uint32_t s_wait_ms;    /* WAIT_KIND_TIMER: length of the wait that started at J.t0 */
+static int     s_result;      /* status of the last finished job */
+static uint16_t s_parts;      /* partial updates since the last full refresh (both modes, saturating) */
+static uint16_t s_n_gray = EPD4G_PARTIALS_BEFORE_FULL;      /* limits, 0 = no automatic full refresh */
+static uint16_t s_n_bw   = EPD4G_BW_PARTIALS_BEFORE_FULL;
+#if EPD4G_AUTO_POWEROFF_MS > 0
+static uint32_t s_idle_t0;    /* tick of the last finished job */
+#endif
+static epd4g_done_cb_t s_cb;
+static void   *s_cb_ctx;
+
+/* The running job. Everything a job needs after a yield lives here, locals do not survive. */
+static struct {
+    uint8_t  kind;            /* JOB_xxx */
+    uint8_t  next;            /* JOB_xxx started when this one finishes with EPD4G_OK (chain), JOB_NONE = none */
+    uint8_t  is_auto;         /* started by the library itself (auto power-off): silent */
+    uint16_t pc;              /* coroutine resume point */
+    int      rc;              /* result */
+    uint32_t t0;              /* start of the current wait */
+    int      bs;              /* busy_poll() result */
+    const uint8_t *fb;        /* 4-gray frame, 2 bpp */
+    const uint8_t *mask;
+    const void    *img;       /* 1-bit job source */
+    uint8_t  src;             /* epd4g_src_t */
+    uint8_t  fullmode;        /* epd4g_full_mode_t */
+    uint8_t  bwmode;          /* epd4g_bw_mode_t */
+    uint8_t  any_gray;        /* partial: some masked pixel is gray -> pass 2 needed */
+    int      xb0, xb1, y0, y1;  /* 1-bit partial window: byte columns, rows */
+    uint8_t  ctl;             /* value for register 0x22 */
+} J;
+
+/* The RAM plane being sent, in slices of EPD4G_ROWS_PER_POLL rows. */
+typedef enum { PASS_FULL, PASS_1, PASS_2, PASS_BW } pass_t;
+static struct {
+    uint8_t  plane;           /* 0 -> RAM 0x24, 1 -> RAM 0x26 */
+    pass_t   pass;
+    int      y, y1;
+    int      xb0, xb1;        /* PASS_BW: byte columns */
+} P;
+
+/* --------------------------- low level access ---------------------------- */
+static void spi(const uint8_t *p, size_t n)
+{
+    if (epd4g_port_spi_write(p, n) != 0)
+        s_io_err = 1;
+}
+
+static void g_cmd(uint8_t reg)
+{
+    epd4g_port_gpio_dc(0);
+    epd4g_port_gpio_cs(0);
+    spi(&reg, 1);
+    epd4g_port_gpio_cs(1);
+}
+
+static void g_data(uint8_t d)
+{
+    epd4g_port_gpio_dc(1);
+    epd4g_port_gpio_cs(0);
+    spi(&d, 1);
+    epd4g_port_gpio_cs(1);
+}
+
+static void g_burst_begin(void)
+{
+    epd4g_port_gpio_dc(1);
+    epd4g_port_gpio_cs(0);
+}
+
+static void g_burst_end(void)
+{
+    epd4g_port_gpio_cs(1);
+}
+
+/* ------------------------- coroutine helpers ------------------------------ */
+/* A job function is `switch (J.pc) { case 0: ... }`; a wait stores a unique case label in J.pc and
+ * returns, the next poll jumps back to it. __COUNTER__ makes the labels unique even when several
+ * macros sit on one source line. A job function returns 1 (pending) or 0 (finished, result in J.rc). */
+#define CR_BEGIN        switch (J.pc) { case 0:
+#define CR_END          } J.pc = 0; return 0
+#define WAIT_KIND_UNKNOWN 0     /* epd4g_wait_hint(): poll again at once */
+#define WAIT_KIND_TIMER   1     /* J.t0 + s_wait_ms */
+#define WAIT_KIND_BUSY    2     /* BUSY pin, timeout EPD4G_BUSY_TIMEOUT_MS from J.t0 */
+#define CR_WAIT_N(cond, wait, kind, n) \
+    do { J.pc = (uint16_t)((n) + 1); /* fallthrough */ case (n) + 1: \
+         if (!(cond)) { s_waiting = (wait); s_wait_kind = (kind); return 1; } } while (0)
+#define CR_WAIT(cond)   CR_WAIT_N(cond, 1, WAIT_KIND_UNKNOWN, __COUNTER__)    /* timer / BUSY: sleep a bit */
+#define CR_SLICE(cond)  CR_WAIT_N(cond, 0, WAIT_KIND_UNKNOWN, __COUNTER__)    /* more data to send: come back at once */
+#define FAIL(code)      do { J.rc = (code); J.pc = 0; return 0; } while (0)
+
+static int elapsed(uint32_t t0, uint32_t ms)
+{
+    return (uint32_t)(epd4g_port_tick_ms() - t0) >= ms;
+}
+
+#define WAIT_MS(ms)     do { J.t0 = epd4g_port_tick_ms(); s_wait_ms = (ms); \
+                             CR_WAIT_N(elapsed(J.t0, s_wait_ms), 1, WAIT_KIND_TIMER, __COUNTER__); } while (0)
+
+/* 0 = still busy, 1 = ready, -1 = timeout (the panel is then considered uninitialised) */
+static int busy_poll(uint32_t t0, const char *where)
+{
+    (void)where;                                             /* used by EPD4G_LOG only */
+    if (epd4g_port_gpio_busy() == 0)                         /* BUSY = 1 -> busy */
+        return 1;
+    if (elapsed(t0, EPD4G_BUSY_TIMEOUT_MS)) {
+        EPD4G_LOG("[epd4g] BUSY timeout in %s\r\n", where);
+        s_mode = MODE_NONE;
+        s_powered = 0;
+        return -1;
+    }
+    return 0;
+}
+
+/* wait for BUSY low, then the settle pause (stock Waveshare code uses 20 ms) */
+#define WAIT_BUSY(where) \
+    do { J.t0 = epd4g_port_tick_ms(); \
+         CR_WAIT_N((J.bs = busy_poll(J.t0, (where))) != 0, 1, WAIT_KIND_BUSY, __COUNTER__); \
+         if (J.bs < 0) FAIL(EPD4G_ERR_TIMEOUT); \
+         if (EPD4G_BUSY_SETTLE_MS > 0) WAIT_MS(EPD4G_BUSY_SETTLE_MS); } while (0)
+
+/* hardware reset pulse (same timing as the stock library) */
+#define HW_RESET() \
+    do { epd4g_port_gpio_cs(1); epd4g_port_gpio_dc(0); \
+         epd4g_port_gpio_rst(1); WAIT_MS(20); \
+         epd4g_port_gpio_rst(0); WAIT_MS(2); \
+         epd4g_port_gpio_rst(1); WAIT_MS(20); } while (0)
+
+/* Start a display update with register 0x22 = ctl (LUT from register or OTP, see callers). */
+static void g_trigger(uint8_t ctl)
+{
+    g_cmd(0x22);
+    g_data(ctl);
+    g_cmd(0x20);
+}
+
+/* ------------------------------- LUT ------------------------------------- */
+/* Layout: [0..59] VS 5 rows x 12 groups (byte = phases A,B,C,D, 2 bit each,
+ * 01=VSH1 10=VSL), [60..143] 12 groups x {TPA,TPB,SRAB,TPC,TPD,SRCD,RP},
+ * [144..152] FR + XON (copied from the stock LUT). */
+#define VSH_A   0x40
+#define VSH_AB  0x50
+#define VSL_A   0x80
+
+static void lut_base(uint8_t *l)
+{
+    memset(l, 0, 153);
+    memcpy(&l[144], &lut_stock[144], 9);
+}
+
+static void lut_group(uint8_t *l, int g, uint8_t tpa, uint8_t tpb, uint8_t tpc, uint8_t tpd, uint8_t rp)
+{
+    uint8_t *p = &l[60 + g * 7];
+    p[0] = tpa; p[1] = tpb; p[2] = 0; p[3] = tpc; p[4] = tpd; p[5] = 0; p[6] = rp;
+}
+
+/* pass 1: row 3 (black) VSH T_BLACK; rows 1,2 (everything else) VSL T_WHITE.
+ * Both start at frame 0; the shorter one is simply idle afterwards. */
+static void lut_build_p1(uint8_t *l)
+{
+    const int common = EPD4G_T_WHITE < EPD4G_T_BLACK ? EPD4G_T_WHITE : EPD4G_T_BLACK;
+    const int diff   = EPD4G_T_WHITE < EPD4G_T_BLACK ? EPD4G_T_BLACK - EPD4G_T_WHITE
+                                                     : EPD4G_T_WHITE - EPD4G_T_BLACK;
+    int g = 0;
+
+    lut_base(l);
+    l[1 * 12 + g] = VSL_A;
+    l[2 * 12 + g] = VSL_A;
+    l[3 * 12 + g] = VSH_A;
+    lut_group(l, g++, (uint8_t)common, 0, 0, 0, 0);
+    if (diff > 0) {
+        if (EPD4G_T_WHITE > EPD4G_T_BLACK) { l[1 * 12 + g] = VSL_A; l[2 * 12 + g] = VSL_A; }
+        else                               { l[3 * 12 + g] = VSH_A; }
+        lut_group(l, g++, (uint8_t)diff, 0, 0, 0, 0);
+    }
+}
+
+/* pass 2: row 1 VSH T_LIGHT frames, row 2 VSH T_DARK frames; rows 0 and 3 idle */
+static void lut_build_p2(uint8_t *l)
+{
+    lut_base(l);
+    l[1 * 12 + 0] = VSH_A;
+    l[2 * 12 + 0] = VSH_AB;
+    lut_group(l, 0, EPD4G_T_LIGHT, (uint8_t)(EPD4G_T_DARK - EPD4G_T_LIGHT), 0, 0, 0);
+}
+
+/* full refresh: stock LUT; FAST adjusts the shake group (group 1) */
+static void lut_build_full(uint8_t *l, epd4g_full_mode_t mode)
+{
+    memcpy(l, lut_stock, 153);
+    /* gray levels: row 1 (light) and row 2 (dark) get VSL in group 0 (phases C, D) and the same
+     * number of VSH frames in group 2 (phases B, C), so the waveform stays DC balanced.
+     * Stock values: light 3, dark 8. Fewer frames = lighter gray. */
+    l[60 + 0 * 7 + 3] = EPD4G_FULL_T_LIGHT;       /* g0 TPC: row 1 VSL */
+    l[60 + 0 * 7 + 4] = EPD4G_FULL_T_DARK;        /* g0 TPD: row 2 VSL */
+    l[60 + 2 * 7 + 1] = EPD4G_FULL_T_LIGHT;       /* g2 TPB: row 1 VSH */
+    l[60 + 2 * 7 + 3] = EPD4G_FULL_T_DARK;        /* g2 TPC: row 2 VSH */
+    if (mode == EPD4G_FULL_FAST) {
+        l[60 + 1 * 7 + 0] = EPD4G_FULL_SHAKE_TP;      /* TPA */
+        l[60 + 1 * 7 + 3] = EPD4G_FULL_SHAKE_TP;      /* TPC */
+        l[60 + 1 * 7 + 6] = EPD4G_FULL_SHAKE_RP;      /* RP  */
+    }
+}
+
+/* ---------------------------- RAM planes --------------------------------- */
+/* Image pixel = 2 bits (11 white, 10 light, 01 dark, 00 black), 4 px per byte, MSB first.
+ * A plane byte holds 8 pixels = 2 image bytes. These tables turn the 4 pixels of one
+ * image byte into 4 plane bits (bit 3 = first pixel):
+ *   t24: inverted low pixel bit  (RAM 0x24, as in the stock 4-gray display routine)
+ *   t26: inverted high pixel bit (RAM 0x26)
+ *   tbk: pixel is black    tgr: pixel is light or dark gray
+ *   tw : pixel >= EPD4G_BW_THRESHOLD (white in 1-bit mode)                                   */
+static uint8_t t24[256], t26[256], tbk[256], tgr[256], tw[256];
+
+static void tables_init(void)
+{
+    for (int b = 0; b < 256; b++) {
+        uint8_t a = 0, c = 0, k = 0, g = 0, w = 0;
+        for (int j = 0; j < 4; j++) {
+            uint8_t px  = (uint8_t)((b >> (6 - 2 * j)) & 3);
+            uint8_t bit = (uint8_t)(1u << (3 - j));
+            if (!(px & 1)) a |= bit;
+            if (!(px & 2)) c |= bit;
+            if (px == 0)   k |= bit;
+            if (px == 1 || px == 2) g |= bit;
+            if (px >= EPD4G_BW_THRESHOLD) w |= bit;
+        }
+        t24[b] = a; t26[b] = c; tbk[b] = k; tgr[b] = g; tw[b] = w;
+    }
+}
+
+static uint8_t pk(const uint8_t *t, const uint8_t *p)
+{
+    return (uint8_t)((t[p[0]] << 4) | t[p[1]]);
+}
+
+/* 1 if some masked pixel has a gray target (pass 2 is needed) */
+static uint8_t mask_has_gray(const uint8_t *fb, const uint8_t *mask)
+{
+    for (int y = 0; y < EPD4G_HEIGHT; y++) {
+        const uint8_t *irow = fb + (size_t)y * EPD4G_FB_STRIDE;
+        const uint8_t *mrow = mask + (size_t)y * EPD4G_MASK_STRIDE;
+        for (int xb = 0; xb < EPD4G_MASK_STRIDE; xb++)
+            if (mrow[xb] && (pk(tgr, irow + xb * 2) & mrow[xb]))
+                return 1;
+    }
+    return 0;
+}
+
+/* Begin sending a plane (command + row counters); plane_step() then sends the rows.
+ * plane: 0 -> RAM 0x24, 1 -> RAM 0x26. mask bit 1 = pixel is updated (NULL = all).
+ * RAM pair (0x24,0x26) per pixel: (0,0) keep; PASS_1: black (1,1), other masked (1,0);
+ * PASS_2: light/dark gray = the pair of the stock encoding, everything else (0,0).
+ * PASS_BW: 1 bit per pixel, rows y0..y1, byte columns xb0..xb1 of the 1-bit image. */
+static void plane_begin(uint8_t plane, pass_t pass, int y0, int y1, int xb0, int xb1)
+{
+    P.plane = plane; P.pass = pass;
+    P.y = y0; P.y1 = y1; P.xb0 = xb0; P.xb1 = xb1;
+    g_cmd(plane ? 0x26 : 0x24);
+}
+
+/* Send up to EPD4G_ROWS_PER_POLL rows; returns 1 while rows remain. CS is released after every
+ * slice, so nothing is left half-way when the main loop does other work in between. */
+static int plane_step(void)
+{
+    uint8_t row[EPD4G_MASK_STRIDE];
+    int rows = EPD4G_ROWS_PER_POLL;
+
+    g_burst_begin();
+    while (P.y <= P.y1 && rows-- > 0) {
+        const int y = P.y++;
+        if (P.pass == PASS_BW) {
+            const int n = P.xb1 - P.xb0 + 1;
+            if (J.src == EPD4G_SRC_1BPP) {
+                spi((const uint8_t *)J.img + (size_t)y * EPD4G_BW_STRIDE + P.xb0, (size_t)n);
+            } else {
+                if (J.src == EPD4G_SRC_WHITE) {
+                    memset(row, 0xFF, (size_t)n);
+                } else {
+                    const uint8_t *irow = (const uint8_t *)J.img + (size_t)y * EPD4G_FB_STRIDE;
+                    for (int i = 0; i < n; i++)
+                        row[i] = pk(tw, irow + (P.xb0 + i) * 2);
+                }
+                spi(row, (size_t)n);
+            }
+        } else {
+            const uint8_t *t = P.plane ? t26 : t24;
+            const uint8_t *irow = J.fb + (size_t)y * EPD4G_FB_STRIDE;
+            const uint8_t *mrow = J.mask ? J.mask + (size_t)y * EPD4G_MASK_STRIDE : NULL;
+            for (int xb = 0; xb < EPD4G_MASK_STRIDE; xb++) {
+                const uint8_t *p = irow + xb * 2;
+                uint8_t m = mrow ? mrow[xb] : 0xFF;
+                uint8_t out;
+                if (P.pass == PASS_FULL) out = pk(t, p);
+                else if (m == 0)         out = 0;                              /* keep */
+                else if (P.pass == PASS_1) out = P.plane ? (uint8_t)(m & pk(tbk, p)) : m;
+                else                     out = (uint8_t)(pk(t, p) & m & pk(tgr, p));
+                row[xb] = out;
+            }
+            spi(row, EPD4G_MASK_STRIDE);
+        }
+    }
+    g_burst_end();
+    return P.y <= P.y1;
+}
+
+/* Registers common to all 4-gray passes. border: 0x80 = no border drive (partial), 0x00 = stock. */
+static void send_setup(uint8_t border)
+{
+    g_cmd(0x3C); g_data(border);
+
+    g_cmd(0x2C); g_data(lut_stock[158]);          /* same order as the stock init */
+    g_cmd(0x3F); g_data(lut_stock[153]);
+    g_cmd(0x03); g_data(lut_stock[154]);
+    g_cmd(0x04); g_data(lut_stock[155]);
+                 g_data(lut_stock[156]);
+                 g_data(lut_stock[157]);
+
+    g_cmd(0x11); g_data(0x03);                    /* entry mode */
+    g_cmd(0x44); g_data(0x00); g_data(0x15);      /* X: 0..21 bytes */
+    g_cmd(0x45); g_data(0x00); g_data(0x00); g_data(0x07); g_data(0x01); /* Y: 0..263 */
+}
+
+/* RAM cursor to the window start */
+static void send_cursor(int xb, int y)
+{
+    g_cmd(0x4E); g_data((uint8_t)xb);
+    g_cmd(0x4F); g_data((uint8_t)(y & 0xFF)); g_data((uint8_t)((y >> 8) & 0x01));
+}
+
+/* LUT + RAM cursor to 0,0 (before the planes of every 4-gray pass) */
+static void send_lut_and_cursor(const uint8_t *lut153)
+{
+    g_cmd(0x32);
+    g_burst_begin();
+    spi(lut153, 153);
+    g_burst_end();
+
+    send_cursor(0, 0);
+}
+
+/* 1-bit: RAM window registers */
+static void send_window(int xb0, int xb1, int y0, int y1)
+{
+    g_cmd(0x44); g_data((uint8_t)xb0); g_data((uint8_t)xb1);
+    g_cmd(0x45); g_data((uint8_t)(y0 & 0xFF)); g_data((uint8_t)((y0 >> 8) & 0x01));
+                 g_data((uint8_t)(y1 & 0xFF)); g_data((uint8_t)((y1 >> 8) & 0x01));
+}
+
+/* Common tail of a job: map a sticky SPI error to a status. */
+static int finish(int rc)
+{
+    if (rc == EPD4G_OK && s_io_err)
+        rc = EPD4G_ERR_IO;
+    s_io_err = 0;
+    return rc;
+}
+
+/* ------------------------------- jobs ------------------------------------- */
+/* power off, used before a reset when the analog part was left on */
+#define POWER_OFF_SEQ(where) \
+    do { g_trigger(0x83); WAIT_BUSY(where); s_powered = 0; } while (0)
+
+static int job_init(void)
+{
+    CR_BEGIN
+    if (s_powered) POWER_OFF_SEQ("pre-init power off");
+    HW_RESET();
+    WAIT_BUSY("reset");
+    g_cmd(0x12);                                  /* soft reset */
+    WAIT_BUSY("soft reset");
+
+    g_cmd(0x74); g_data(0x54);                    /* analog block control  */
+    g_cmd(0x7E); g_data(0x3B);                    /* digital block control */
+    g_cmd(0x01); g_data(0x07); g_data(0x01); g_data(0x00);   /* driver output control: 264 lines */
+    g_cmd(0x11); g_data(0x03);                    /* data entry mode */
+    g_cmd(0x44); g_data(0x00); g_data(0x15);      /* RAM X: 0..21 bytes */
+    g_cmd(0x45); g_data(0x00); g_data(0x00); g_data(0x07); g_data(0x01);   /* RAM Y: 0..263 */
+    g_cmd(0x3C); g_data(0x00);                    /* border waveform */
+    g_cmd(0x2C); g_data(lut_stock[158]);          /* VCOM */
+    g_cmd(0x3F); g_data(lut_stock[153]);          /* EOPQ */
+    g_cmd(0x03); g_data(lut_stock[154]);          /* VGH  */
+    g_cmd(0x04); g_data(lut_stock[155]);          /* VSH1 */
+                 g_data(lut_stock[156]);          /* VSH2 */
+                 g_data(lut_stock[157]);          /* VSL  */
+    g_cmd(0x32);
+    g_burst_begin(); spi(lut_stock, 153); g_burst_end();      /* stock 4-gray LUT */
+    send_cursor(0, 0);
+    WAIT_BUSY("init");
+
+    s_mode = MODE_GRAY;
+    EPD4G_LOG("[epd4g] init done\r\n");
+    CR_END;
+}
+
+static int job_full(void)
+{
+    uint8_t lut[153];
+    CR_BEGIN
+    PROF_BEGIN();
+    lut_build_full(lut, (epd4g_full_mode_t)J.fullmode);
+    send_setup(0x00);
+    send_lut_and_cursor(lut);
+    PROF(setup);
+    plane_begin(0, PASS_FULL, 0, EPD4G_HEIGHT - 1, 0, 0);
+    CR_SLICE(plane_step() == 0);
+    plane_begin(1, PASS_FULL, 0, EPD4G_HEIGHT - 1, 0, 0);
+    CR_SLICE(plane_step() == 0);
+    s_data = 0;
+    PROF(spi1);
+    /* 0xC7 = clock+analog on, display, analog+clock off (stock, powers down)
+     * 0xC4 = clock+analog on, display, stay powered                         */
+    g_trigger(EPD4G_KEEP_POWER ? 0xC4 : 0xC7);
+    s_powered = EPD4G_KEEP_POWER;
+    WAIT_BUSY("full refresh");
+    PROF(wait1);
+    s_parts = 0;
+    CR_END;
+}
+
+static int job_partial(void)
+{
+    uint8_t lut[153];
+    CR_BEGIN
+    PROF_BEGIN();
+    J.any_gray = mask_has_gray(J.fb, J.mask);
+    lut_build_p1(lut);
+    send_setup(0x80);
+    send_lut_and_cursor(lut);
+    PROF(setup);
+    plane_begin(0, PASS_1, 0, EPD4G_HEIGHT - 1, 0, 0);
+    CR_SLICE(plane_step() == 0);
+    plane_begin(1, PASS_1, 0, EPD4G_HEIGHT - 1, 0, 0);
+    CR_SLICE(plane_step() == 0);
+    if (!J.any_gray) s_data = 0;
+    PROF(spi1);
+    g_trigger(EPD4G_KEEP_POWER ? 0xC4 : 0xC7);
+    s_powered = EPD4G_KEEP_POWER;
+    WAIT_BUSY("partial pass 1");
+    PROF(wait1);
+
+    if (J.any_gray) {                             /* pass 2 only draws the gray levels */
+        lut_build_p2(lut);
+        send_lut_and_cursor(lut);
+        plane_begin(0, PASS_2, 0, EPD4G_HEIGHT - 1, 0, 0);
+        CR_SLICE(plane_step() == 0);
+        plane_begin(1, PASS_2, 0, EPD4G_HEIGHT - 1, 0, 0);
+        CR_SLICE(plane_step() == 0);
+        s_data = 0;
+        PROF(spi2);
+        g_trigger(EPD4G_KEEP_POWER ? 0xC4 : 0xC7);
+        WAIT_BUSY("partial pass 2");
+        PROF(wait2);
+    }
+    CR_END;
+}
+
+static int job_power_off(void)
+{
+    CR_BEGIN
+    g_trigger(0x83);                              /* clock on, analog off, clock off */
+    WAIT_BUSY("power off");
+    s_powered = 0;
+    CR_END;
+}
+
+static int job_sleep(void)
+{
+    CR_BEGIN
+    if (s_powered) {                              /* s_powered is exact: nothing to switch off otherwise */
+        g_trigger(0x83);
+        WAIT_BUSY("power off");
+    }
+    g_cmd(0x10);
+    g_data(0x01);                                 /* deep sleep mode 1 (stock Sleep). Whether the RAM survives it is
+                                                   * panel dependent: the 4-gray mode does not rely on it (init to wake);
+                                                   * the 1-bit mode does (see s_asleep), not yet verified on hardware */
+    s_powered = 0;
+    if (s_mode == MODE_BW) {
+        s_asleep = 1;                             /* RAM planes stay valid: partial updates can continue */
+    } else {
+        s_mode = MODE_NONE;
+    }
+    CR_END;
+}
+
+/* ---- 1-bit mode: stock EPD_2in7_V2 sequences ---- */
+static int job_bw_init(void)
+{
+    CR_BEGIN
+    if (s_powered) POWER_OFF_SEQ("pre-init power off");
+    HW_RESET();
+    WAIT_BUSY("reset");
+    g_cmd(0x12);                                  /* SWRESET */
+    WAIT_BUSY("soft reset");
+    if (J.bwmode == EPD4G_BW_FAST) {
+        g_cmd(0x18); g_data(0x80);                /* read built-in temperature sensor */
+        g_cmd(0x22); g_data(0xB1);                /* load temperature value */
+        g_cmd(0x20);
+        WAIT_BUSY("temperature");
+        g_cmd(0x1A); g_data(0x64); g_data(0x00);  /* write temperature register */
+    }
+    g_cmd(0x45); g_data(0x00); g_data(0x00); g_data(0x07); g_data(0x01);   /* RAM Y: 0..263 */
+    g_cmd(0x4F); g_data(0x00); g_data(0x00);      /* RAM Y counter 0 */
+    g_cmd(0x11); g_data(0x03);                    /* data entry mode */
+    if (J.bwmode == EPD4G_BW_FAST) {
+        g_cmd(0x22); g_data(0x91);                /* load the waveform for the temperature above */
+        g_cmd(0x20);
+        WAIT_BUSY("fast lut");
+    }
+    s_mode = MODE_BW;
+    s_asleep = 0;
+    s_base = 0;
+    s_win_full = 1;                               /* power-on default of 0x44 is 0..21 bytes */
+    s_border_part = 0;
+    s_fast_lut = (J.bwmode == EPD4G_BW_FAST);
+    CR_END;
+}
+
+static int job_bw_full(void)
+{
+    CR_BEGIN
+    if (!s_win_full) {
+        send_window(0, EPD4G_BW_STRIDE - 1, 0, EPD4G_HEIGHT - 1);
+        s_win_full = 1;
+    }
+    if (s_border_part) {
+        g_cmd(0x3C); g_data(EPD4G_BW_BORDER_FULL);
+        s_border_part = 0;
+    }
+    /* stock Display_Base: the image goes to both planes, so the panel's "old" picture is right */
+    send_cursor(0, 0);
+    plane_begin(0, PASS_BW, 0, EPD4G_HEIGHT - 1, 0, EPD4G_BW_STRIDE - 1);
+    CR_SLICE(plane_step() == 0);
+    send_cursor(0, 0);
+    plane_begin(1, PASS_BW, 0, EPD4G_HEIGHT - 1, 0, EPD4G_BW_STRIDE - 1);
+    CR_SLICE(plane_step() == 0);
+    s_data = 0;
+    /* 0xF7: load temperature + LUT, display mode 1, power down (stock Display / Clear)
+     * 0xC7: stock Display_Fast, uses the LUT loaded by Init_Fast                        */
+    J.ctl = (J.bwmode == EPD4G_BW_FAST) ? 0xC7 : 0xF7;
+    if (EPD4G_BW_KEEP_POWER) J.ctl = (uint8_t)(J.ctl & 0xFC);
+    g_trigger(J.ctl);
+    s_powered = EPD4G_BW_KEEP_POWER;
+    WAIT_BUSY("bw full");
+    s_base = 1;
+    s_parts = 0;
+    if (J.bwmode != EPD4G_BW_FAST) s_fast_lut = 0;      /* 0xF7 reloaded the normal waveform */
+    CR_END;
+}
+
+static int job_bw_partial(void)
+{
+    CR_BEGIN
+    if (EPD4G_BW_PARTIAL_RESET) {                 /* stock Display_Partial starts with a hardware reset */
+        HW_RESET();                               /* ... which also wakes the panel from deep sleep */
+    }
+    s_asleep = 0;
+    g_cmd(0x3C); g_data(0x80);                    /* border waveform */
+    send_window(J.xb0, J.xb1, J.y0, J.y1);
+    send_cursor(J.xb0, J.y0);
+    plane_begin(0, PASS_BW, J.y0, J.y1, J.xb0, J.xb1);
+    CR_SLICE(plane_step() == 0);
+#if !EPD4G_BW_RESYNC
+    s_data = 0;
+#endif
+    J.ctl = EPD4G_BW_KEEP_POWER ? 0xFC : 0xFF;    /* 0xFF: load LUT, display mode 2, power down */
+    g_trigger(J.ctl);
+    s_powered = EPD4G_BW_KEEP_POWER;
+    s_win_full = (J.xb0 == 0 && J.xb1 == EPD4G_BW_STRIDE - 1 && J.y0 == 0 && J.y1 == EPD4G_HEIGHT - 1);
+    s_border_part = 1;
+    s_fast_lut = 0;                               /* the partial waveform replaced it */
+    WAIT_BUSY("bw partial");
+#if EPD4G_BW_RESYNC
+    /* The RAM planes swapped roles during the update: write the window into the plane that 0x24 now
+     * addresses, so that both planes hold the picture that is on the glass (see EPD4G_BW_RESYNC). */
+    send_window(J.xb0, J.xb1, J.y0, J.y1);
+    send_cursor(J.xb0, J.y0);
+    plane_begin(0, PASS_BW, J.y0, J.y1, J.xb0, J.xb1);
+    CR_SLICE(plane_step() == 0);
+    s_data = 0;
+#endif
+    CR_END;
+}
+
+/* ------------------------------ scheduler -------------------------------- */
+static int job_run(void)
+{
+    switch (J.kind) {
+    case JOB_INIT:       return job_init();
+    case JOB_FULL:       return job_full();
+    case JOB_PARTIAL:    return job_partial();
+    case JOB_BW_INIT:    return job_bw_init();
+    case JOB_BW_FULL:    return job_bw_full();
+    case JOB_BW_PARTIAL: return job_bw_partial();
+    case JOB_POWER_OFF:  return job_power_off();
+    case JOB_SLEEP:      return job_sleep();
+    case JOB_NOP:        return 0;                 /* nothing to do: finishes (result, callback) in this poll */
+    default:             return 0;
+    }
+}
+
+#if EPD4G_AUTO_POWEROFF_MS > 0
+/* Idle with the analog part on for long enough: queue a silent power-off job. */
+static int auto_poweroff_start(void)
+{
+    if (!s_powered || s_asleep || s_mode == MODE_NONE)
+        return 0;
+    if (!elapsed(s_idle_t0, EPD4G_AUTO_POWEROFF_MS))
+        return 0;
+    J.kind = JOB_POWER_OFF; J.next = JOB_NONE; J.is_auto = 1;
+    J.pc = 0; J.rc = EPD4G_OK;
+    s_io_err = 0; s_data = 0; s_waiting = 0;
+    return 1;
+}
+#endif
+
+int epd4g_poll(void)
+{
+    int rc;
+
+    if (J.kind == JOB_NONE) {
+#if EPD4G_AUTO_POWEROFF_MS > 0
+        if (!auto_poweroff_start())
+            return 0;
+#else
+        return 0;
+#endif
+    }
+    s_waiting = 0;
+    if (job_run() != 0)
+        return EPD4G_PENDING;
+
+    rc = finish(J.rc);
+    if (rc == EPD4G_OK && J.next != JOB_NONE) {    /* chained job (e.g. init before an automatic full refresh) */
+        J.kind = J.next; J.next = JOB_NONE;
+        J.pc = 0; J.rc = EPD4G_OK;
+        s_waiting = 0;
+        return EPD4G_PENDING;
+    }
+    J.next = JOB_NONE;
+    s_data = 0;
+    J.kind = JOB_NONE;
+    J.pc = 0;
+#if EPD4G_AUTO_POWEROFF_MS > 0
+    s_idle_t0 = epd4g_port_tick_ms();
+#endif
+    if (J.is_auto) {                               /* the library's own job: the application never asked for it */
+        J.is_auto = 0;
+        return 0;
+    }
+    s_result = rc;
+    if (s_cb != NULL)
+        s_cb(rc, s_cb_ctx);
+    return 0;
+}
+
+int epd4g_is_busy(void)            { return J.kind != JOB_NONE; }
+int epd4g_data_busy(void)          { return s_data; }
+int epd4g_result(void)             { return s_result; }
+void epd4g_set_done_cb(epd4g_done_cb_t cb, void *ctx) { s_cb = cb; s_cb_ctx = ctx; }
+
+int epd4g_wait(void)
+{
+    while (epd4g_poll() != 0) {
+        if (s_waiting)
+            epd4g_port_delay_ms(EPD4G_BUSY_POLL_MS);
+    }
+    return s_result;
+}
+
+/* Time left of a wait that began at t0 and lasts ms; 0 = over. */
+static uint32_t wait_left(uint32_t t0, uint32_t ms)
+{
+    const uint32_t used = (uint32_t)(epd4g_port_tick_ms() - t0);
+    return (used >= ms) ? 0U : (ms - used);
+}
+
+uint32_t epd4g_wait_hint(int *on_busy)
+{
+    if (on_busy != NULL)
+        *on_busy = 0;
+
+    if (J.kind == JOB_NONE) {
+#if EPD4G_AUTO_POWEROFF_MS > 0
+        if (s_powered && !s_asleep && s_mode != MODE_NONE)
+            return wait_left(s_idle_t0, EPD4G_AUTO_POWEROFF_MS);
+#endif
+        return EPD4G_WAIT_FOREVER;
+    }
+    if (!s_waiting)                                  /* data slice or a job that has not run yet */
+        return 0;
+
+    switch (s_wait_kind) {
+    case WAIT_KIND_TIMER:
+        return wait_left(J.t0, s_wait_ms);
+    case WAIT_KIND_BUSY:
+        if (epd4g_port_gpio_busy() == 0)             /* already ready: the next poll moves on */
+            return 0;
+        if (on_busy != NULL)
+            *on_busy = 1;
+        return wait_left(J.t0, EPD4G_BUSY_TIMEOUT_MS);
+    default:
+        return 0;
+    }
+}
+
+void epd4g_abort(void)
+{
+    J.kind = JOB_NONE;
+    J.pc = 0;
+    J.next = JOB_NONE;
+    J.is_auto = 0;
+    s_mode = MODE_NONE;
+    s_asleep = 0;
+    s_powered = 0;
+    s_data = 0;
+    s_io_err = 0;
+    s_waiting = 0;
+}
+
+/* ------------------------------ start API -------------------------------- */
+static int job_start(uint8_t kind)
+{
+    if (J.kind != JOB_NONE)
+        return EPD4G_ERR_BUSY;
+    J.kind = kind;
+    J.next = JOB_NONE;
+    J.is_auto = 0;
+    J.pc = 0;
+    J.rc = EPD4G_OK;
+    s_io_err = 0;
+    s_waiting = 0;
+    return EPD4G_OK;
+}
+
+static int need_mode(uint8_t mode)
+{
+    if (s_mode == MODE_NONE) return EPD4G_ERR_NOT_INIT;
+    if (s_mode != mode)      return EPD4G_ERR_MODE;
+    return EPD4G_OK;
+}
+
+int epd4g_gray_ready(void)
+{
+    return need_mode(MODE_GRAY);
+}
+
+int epd4g_start_noop(void)
+{
+    int rc = job_start(JOB_NOP);
+    if (rc != EPD4G_OK) return rc;
+    s_data = 0;
+    return EPD4G_OK;
+}
+
+void epd4g_set_partials_before_full(unsigned gray, unsigned bw)
+{
+    s_n_gray = (uint16_t)(gray > 0xFFFFu ? 0xFFFFu : gray);
+    s_n_bw   = (uint16_t)(bw   > 0xFFFFu ? 0xFFFFu : bw);
+}
+
+unsigned epd4g_partials_since_full(void)
+{
+    return s_parts;
+}
+
+int epd4g_full_due(void)
+{
+    if (s_mode == MODE_GRAY) return s_n_gray != 0 && s_parts >= s_n_gray;
+    if (s_mode == MODE_BW)   return s_n_bw   != 0 && s_parts >= s_n_bw;
+    return 0;
+}
+
+int epd4g_start_init(void)
+{
+    int rc = job_start(JOB_INIT);
+    if (rc != EPD4G_OK) return rc;
+    s_mode = MODE_NONE;
+    s_asleep = 0;
+    tables_init();
+    return EPD4G_OK;
+}
+
+int epd4g_start_full(const uint8_t *fb, epd4g_full_mode_t mode)
+{
+    int rc;
+    if (fb == NULL) return EPD4G_ERR_PARAM;
+    if (J.kind != JOB_NONE) return EPD4G_ERR_BUSY;
+    if ((rc = need_mode(MODE_GRAY)) != EPD4G_OK) return rc;
+    job_start(JOB_FULL); s_data = 1;
+    J.fb = fb; J.mask = NULL; J.fullmode = (uint8_t)mode;
+    return EPD4G_OK;
+}
+
+int epd4g_start_partial(const uint8_t *fb, const uint8_t *mask)
+{
+    int rc;
+    if (fb == NULL || mask == NULL) return EPD4G_ERR_PARAM;
+    if (J.kind != JOB_NONE) return EPD4G_ERR_BUSY;
+    if ((rc = need_mode(MODE_GRAY)) != EPD4G_OK) return rc;
+    if (s_n_gray != 0 && s_parts >= s_n_gray) {                 /* limit reached: redraw everything instead */
+        job_start(JOB_FULL); s_data = 1;
+        J.fb = fb; J.mask = NULL; J.fullmode = (uint8_t)EPD4G_AUTO_FULL_MODE;
+        return EPD4G_OK;
+    }
+    job_start(JOB_PARTIAL); s_data = 1;
+    if (s_parts < 0xFFFFu) s_parts++;
+    J.fb = fb; J.mask = mask;
+    return EPD4G_OK;
+}
+
+int epd4g_start_power_off(void)
+{
+    if (J.kind != JOB_NONE) return EPD4G_ERR_BUSY;
+    if (s_mode == MODE_NONE) return EPD4G_ERR_NOT_INIT;
+    if (s_asleep || !s_powered)                                /* nothing to switch off: a no-op job */
+        return epd4g_start_noop();
+    return job_start(JOB_POWER_OFF);
+}
+
+int epd4g_start_sleep(void)
+{
+    if (J.kind != JOB_NONE) return EPD4G_ERR_BUSY;
+    if (s_mode == MODE_NONE) return EPD4G_ERR_NOT_INIT;
+    if (s_asleep)                                              /* already asleep: a no-op job */
+        return epd4g_start_noop();
+    return job_start(JOB_SLEEP);
+}
+
+int epd4g_start_bw_init(epd4g_bw_mode_t mode)
+{
+    int rc = job_start(JOB_BW_INIT);
+    if (rc != EPD4G_OK) return rc;
+    s_mode = MODE_NONE;
+    tables_init();
+    J.bwmode = (uint8_t)mode;
+    return EPD4G_OK;
+}
+
+int epd4g_start_bw_full(const void *img, epd4g_src_t src, epd4g_bw_mode_t mode)
+{
+    int rc;
+    if (img == NULL && src != EPD4G_SRC_WHITE) return EPD4G_ERR_PARAM;
+    if (src != EPD4G_SRC_1BPP && src != EPD4G_SRC_2BPP && src != EPD4G_SRC_WHITE) return EPD4G_ERR_PARAM;
+    if (J.kind != JOB_NONE) return EPD4G_ERR_BUSY;
+    if ((rc = need_mode(MODE_BW)) != EPD4G_OK) return rc;
+    if (s_asleep) return EPD4G_ERR_NOT_INIT;                    /* a full refresh needs epd4g_bw_init() */
+    if (mode == EPD4G_BW_FAST && !s_fast_lut) return EPD4G_ERR_MODE;
+    job_start(JOB_BW_FULL); s_data = (src != EPD4G_SRC_WHITE);
+    J.img = img; J.src = (uint8_t)src; J.bwmode = (uint8_t)mode;
+    return EPD4G_OK;
+}
+
+int epd4g_start_bw_clear(epd4g_bw_mode_t mode)
+{
+    return epd4g_start_bw_full(NULL, EPD4G_SRC_WHITE, mode);
+}
+
+int epd4g_start_bw_partial(const void *img, epd4g_src_t src, const epd4g_rect_t *rect)
+{
+    int rc, x0 = 0, y0 = 0, x1 = EPD4G_WIDTH - 1, y1 = EPD4G_HEIGHT - 1;
+    if (img == NULL && src != EPD4G_SRC_WHITE) return EPD4G_ERR_PARAM;
+    if (src != EPD4G_SRC_1BPP && src != EPD4G_SRC_2BPP && src != EPD4G_SRC_WHITE) return EPD4G_ERR_PARAM;
+    if (rect != NULL) {
+        x0 = rect->x0; y0 = rect->y0; x1 = rect->x1; y1 = rect->y1;
+        if (x0 < 0) x0 = 0;
+        if (y0 < 0) y0 = 0;
+        if (x1 >= EPD4G_WIDTH)  x1 = EPD4G_WIDTH - 1;
+        if (y1 >= EPD4G_HEIGHT) y1 = EPD4G_HEIGHT - 1;
+        if (x0 > x1 || y0 > y1) return EPD4G_ERR_PARAM;
+    }
+    if (J.kind != JOB_NONE) return EPD4G_ERR_BUSY;
+    if ((rc = need_mode(MODE_BW)) != EPD4G_OK) return rc;
+    if (s_asleep && !EPD4G_BW_PARTIAL_RESET) return EPD4G_ERR_NOT_INIT;   /* no reset -> nothing wakes the panel */
+    if (!s_base) return EPD4G_ERR_NO_BASE;
+    if (s_n_bw != 0 && s_parts >= s_n_bw) {                     /* limit reached: full refresh of the same frame */
+        if (s_asleep) {                                         /* a full refresh needs the init the sleep took away */
+            job_start(JOB_BW_INIT); J.next = JOB_BW_FULL;
+            s_mode = MODE_NONE; tables_init();
+        } else {
+            job_start(JOB_BW_FULL);
+        }
+        s_data = (src != EPD4G_SRC_WHITE);
+        J.img = img; J.src = (uint8_t)src; J.bwmode = (uint8_t)EPD4G_BW_NORMAL;
+        return EPD4G_OK;
+    }
+    job_start(JOB_BW_PARTIAL); s_data = (src != EPD4G_SRC_WHITE);
+    if (s_parts < 0xFFFFu) s_parts++;
+    J.img = img; J.src = (uint8_t)src;
+    J.xb0 = x0 >> 3; J.xb1 = x1 >> 3; J.y0 = y0; J.y1 = y1;
+    return EPD4G_OK;
+}
+
+/* ------------------------------ blocking API ----------------------------- */
+static int blocking(int rc)
+{
+    return rc != EPD4G_OK ? rc : epd4g_wait();
+}
+
+int epd4g_init(void)                                 { return blocking(epd4g_start_init()); }
+int epd4g_full(const uint8_t *fb, epd4g_full_mode_t m) { return blocking(epd4g_start_full(fb, m)); }
+int epd4g_partial(const uint8_t *fb, const uint8_t *mask) { return blocking(epd4g_start_partial(fb, mask)); }
+int epd4g_power_off(void)                            { return blocking(epd4g_start_power_off()); }
+int epd4g_sleep(void)                                { return blocking(epd4g_start_sleep()); }
+int epd4g_bw_init(epd4g_bw_mode_t m)                 { return blocking(epd4g_start_bw_init(m)); }
+int epd4g_bw_full(const void *img, epd4g_src_t s, epd4g_bw_mode_t m) { return blocking(epd4g_start_bw_full(img, s, m)); }
+int epd4g_bw_clear(epd4g_bw_mode_t m)                { return blocking(epd4g_start_bw_clear(m)); }
+int epd4g_bw_partial(const void *img, epd4g_src_t s, const epd4g_rect_t *r) { return blocking(epd4g_start_bw_partial(img, s, r)); }
diff --git a/third_party/epd4g/src/epd4g_fb.c b/third_party/epd4g/src/epd4g_fb.c
new file mode 100644
index 0000000..bdfc287
--- /dev/null
+++ b/third_party/epd4g/src/epd4g_fb.c
@@ -0,0 +1,301 @@
+/**
+ * @file epd4g_fb.c
+ * @brief Frame buffer, rotation and update-mask helpers (optional part of epd4g).
+ */
+#include "epd4g_fb.h"
+#include <string.h>
+
+#if defined(__GNUC__) && !defined(__clang__) && !defined(__OPTIMIZE__) && !defined(EPD4G_NO_FORCE_O2)
+#pragma GCC optimize ("O2")
+#endif
+
+/* ------------------------------ rotation --------------------------------- */
+int epd4g_logical_width(epd4g_rot_t rot)
+{
+    return (rot == EPD4G_ROT_90 || rot == EPD4G_ROT_270) ? EPD4G_HEIGHT : EPD4G_WIDTH;
+}
+
+int epd4g_logical_height(epd4g_rot_t rot)
+{
+    return (rot == EPD4G_ROT_90 || rot == EPD4G_ROT_270) ? EPD4G_WIDTH : EPD4G_HEIGHT;
+}
+
+int epd4g_map(epd4g_rot_t rot, int x, int y, int *nx, int *ny)
+{
+    const int lw = epd4g_logical_width(rot), lh = epd4g_logical_height(rot);
+    if (x < 0 || y < 0 || x >= lw || y >= lh)
+        return -1;
+    switch (rot) {
+    case EPD4G_ROT_90:  *nx = lh - 1 - y; *ny = x;           break;
+    case EPD4G_ROT_180: *nx = lw - 1 - x; *ny = lh - 1 - y;  break;
+    case EPD4G_ROT_270: *nx = y;          *ny = lw - 1 - x;  break;
+    default:            *nx = x;          *ny = y;           break;
+    }
+    return 0;
+}
+
+int epd4g_map_rect(epd4g_rot_t rot, int x0, int y0, int x1, int y1, epd4g_rect_t *out)
+{
+    int ax, ay, bx, by;
+    const int lw = epd4g_logical_width(rot), lh = epd4g_logical_height(rot);
+
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 >= lw) x1 = lw - 1;
+    if (y1 >= lh) y1 = lh - 1;
+    if (x0 > x1 || y0 > y1 || out == NULL)
+        return -1;
+    epd4g_map(rot, x0, y0, &ax, &ay);
+    epd4g_map(rot, x1, y1, &bx, &by);
+    out->x0 = ax < bx ? ax : bx;  out->x1 = ax < bx ? bx : ax;
+    out->y0 = ay < by ? ay : by;  out->y1 = ay < by ? by : ay;
+    return 0;
+}
+
+/* ----------------------------- frame buffer ------------------------------ */
+void epd4g_fb_fill(uint8_t *fb, uint8_t level)
+{
+    uint8_t v = (uint8_t)(level & 3);
+    memset(fb, (v << 6) | (v << 4) | (v << 2) | v, EPD4G_FB_BYTES);
+}
+
+void epd4g_fb_set(uint8_t *fb, int x, int y, uint8_t level)
+{
+    if (x < 0 || y < 0 || x >= EPD4G_WIDTH || y >= EPD4G_HEIGHT)
+        return;
+    size_t i = (size_t)y * EPD4G_FB_STRIDE + (size_t)(x >> 2);
+    int sh = 6 - 2 * (x & 3);
+    fb[i] = (uint8_t)((fb[i] & ~(3u << sh)) | ((unsigned)(level & 3) << sh));
+}
+
+uint8_t epd4g_fb_get(const uint8_t *fb, int x, int y)
+{
+    if (x < 0 || y < 0 || x >= EPD4G_WIDTH || y >= EPD4G_HEIGHT)
+        return EPD4G_WHITE;
+    return (uint8_t)((fb[(size_t)y * EPD4G_FB_STRIDE + (size_t)(x >> 2)] >> (6 - 2 * (x & 3))) & 3);
+}
+
+void epd4g_fb_set_rot(uint8_t *fb, epd4g_rot_t rot, int x, int y, uint8_t level)
+{
+    int nx, ny;
+    if (epd4g_map(rot, x, y, &nx, &ny) == 0)
+        epd4g_fb_set(fb, nx, ny, level);
+}
+
+uint8_t epd4g_fb_get_rot(const uint8_t *fb, epd4g_rot_t rot, int x, int y)
+{
+    int nx, ny;
+    if (epd4g_map(rot, x, y, &nx, &ny) != 0)
+        return EPD4G_WHITE;
+    return epd4g_fb_get(fb, nx, ny);
+}
+
+void epd4g_fb_copy_rect(uint8_t *dst, const uint8_t *src, const epd4g_rect_t *r)
+{
+    int x0 = r->x0 < 0 ? 0 : r->x0, x1 = r->x1 >= EPD4G_WIDTH ? EPD4G_WIDTH - 1 : r->x1;
+    int y0 = r->y0 < 0 ? 0 : r->y0, y1 = r->y1 >= EPD4G_HEIGHT ? EPD4G_HEIGHT - 1 : r->y1;
+    if (x0 > x1 || y0 > y1)
+        return;
+    int xb0 = x0 >> 2, xb1 = x1 >> 2;
+    for (int y = y0; y <= y1; y++) {
+        size_t o = (size_t)y * EPD4G_FB_STRIDE + (size_t)xb0;
+        memcpy(&dst[o], &src[o], (size_t)(xb1 - xb0 + 1));
+    }
+}
+
+/* -------------------------------- masks ---------------------------------- */
+void epd4g_mask_clear(uint8_t *mask)
+{
+    memset(mask, 0, EPD4G_MASK_BYTES);
+}
+
+void epd4g_mask_set(uint8_t *mask, int x, int y)
+{
+    if (x < 0 || y < 0 || x >= EPD4G_WIDTH || y >= EPD4G_HEIGHT)
+        return;
+    mask[(size_t)y * EPD4G_MASK_STRIDE + (size_t)(x >> 3)] |= (uint8_t)(0x80u >> (x & 7));
+}
+
+void epd4g_mask_set_rect(uint8_t *mask, const epd4g_rect_t *r)
+{
+    int x0 = r->x0 < 0 ? 0 : r->x0, x1 = r->x1 >= EPD4G_WIDTH ? EPD4G_WIDTH - 1 : r->x1;
+    int y0 = r->y0 < 0 ? 0 : r->y0, y1 = r->y1 >= EPD4G_HEIGHT ? EPD4G_HEIGHT - 1 : r->y1;
+    if (x0 > x1 || y0 > y1)
+        return;
+    const int b0 = x0 >> 3, b1 = x1 >> 3;
+    const uint8_t left  = (uint8_t)(0xFFu >> (x0 & 7));            /* bits x0 .. end of its byte */
+    const uint8_t right = (uint8_t)(0xFFu << (7 - (x1 & 7)));      /* start of its byte .. x1    */
+    for (int y = y0; y <= y1; y++) {
+        uint8_t *row = mask + (size_t)y * EPD4G_MASK_STRIDE;
+        if (b0 == b1) {
+            row[b0] |= (uint8_t)(left & right);
+        } else {
+            row[b0] |= left;
+            for (int b = b0 + 1; b < b1; b++)
+                row[b] = 0xFF;
+            row[b1] |= right;
+        }
+    }
+}
+
+uint32_t epd4g_mask_from_diff(uint8_t *mask, const uint8_t *prev, const uint8_t *cur,
+                              const epd4g_rect_t *roi)
+{
+    int x0 = 0, y0 = 0, x1 = EPD4G_WIDTH - 1, y1 = EPD4G_HEIGHT - 1;
+    uint32_t n = 0;
+
+    epd4g_mask_clear(mask);
+    if (roi != NULL) {
+        if (roi->x0 > x0) x0 = roi->x0;
+        if (roi->y0 > y0) y0 = roi->y0;
+        if (roi->x1 < x1) x1 = roi->x1;
+        if (roi->y1 < y1) y1 = roi->y1;
+    }
+    if (x0 > x1 || y0 > y1)
+        return 0;
+
+    for (int y = y0; y <= y1; y++) {
+        const size_t row = (size_t)y * EPD4G_FB_STRIDE;
+        for (int xb = x0 >> 2; xb <= (x1 >> 2); xb++) {
+            uint8_t a = prev[row + (size_t)xb], b = cur[row + (size_t)xb];
+            if (a == b)
+                continue;                                  /* 4 pixels equal */
+            for (int k = 0; k < 4; k++) {
+                int x = xb * 4 + k;
+                if (x < x0 || x > x1)
+                    continue;
+                int sh = 6 - 2 * k;
+                if (((a ^ b) >> sh) & 3) {
+                    mask[(size_t)y * EPD4G_MASK_STRIDE + (size_t)(x >> 3)] |= (uint8_t)(0x80u >> (x & 7));
+                    n++;
+                }
+            }
+        }
+    }
+    return n;
+}
+
+#if EPD4G_INTERNAL_MASK
+/* One scratch mask shared by the partial_diff / partial_rect helpers. A running job reads it, so the
+ * start functions refuse (EPD4G_ERR_BUSY) while a job is in progress. */
+static uint8_t s_mask[EPD4G_MASK_BYTES];
+
+int epd4g_start_partial_diff(const uint8_t *prev, const uint8_t *cur,
+                             const epd4g_rect_t *roi, uint32_t *changed)
+{
+    uint32_t n;
+    int rc;
+
+    if (prev == NULL || cur == NULL)
+        return EPD4G_ERR_PARAM;
+    if (epd4g_is_busy())
+        return EPD4G_ERR_BUSY;
+    if ((rc = epd4g_gray_ready()) != EPD4G_OK)       /* before the (relatively slow) mask is built */
+        return rc;
+    n = epd4g_mask_from_diff(s_mask, prev, cur, roi);
+    if (changed != NULL)
+        *changed = n;
+    if (n == 0)
+        return epd4g_start_noop();                   /* nothing to draw; finishes in the next poll */
+    return epd4g_start_partial(cur, s_mask);
+}
+
+int epd4g_start_partial_rect(const uint8_t *fb, const epd4g_rect_t *rect)
+{
+    int rc;
+
+    if (fb == NULL || rect == NULL)
+        return EPD4G_ERR_PARAM;
+    if (rect->x0 > rect->x1 || rect->y0 > rect->y1 ||
+        rect->x1 < 0 || rect->y1 < 0 || rect->x0 >= EPD4G_WIDTH || rect->y0 >= EPD4G_HEIGHT)
+        return EPD4G_ERR_PARAM;
+    if (epd4g_is_busy())
+        return EPD4G_ERR_BUSY;
+    if ((rc = epd4g_gray_ready()) != EPD4G_OK)
+        return rc;
+    epd4g_mask_clear(s_mask);
+    epd4g_mask_set_rect(s_mask, rect);
+    return epd4g_start_partial(fb, s_mask);
+}
+
+int epd4g_partial_diff(const uint8_t *prev, const uint8_t *cur,
+                       const epd4g_rect_t *roi, uint32_t *changed)
+{
+    int rc = epd4g_start_partial_diff(prev, cur, roi, changed);
+    return rc != EPD4G_OK ? rc : epd4g_wait();      /* nothing changed: a no-op job, wait() returns at once */
+}
+
+int epd4g_partial_rect(const uint8_t *fb, const epd4g_rect_t *rect)
+{
+    int rc = epd4g_start_partial_rect(fb, rect);
+    return rc != EPD4G_OK ? rc : epd4g_wait();
+}
+#endif
+
+/* ------------------------------ 1-bit frame ------------------------------- */
+void epd4g_bw_fb_fill(uint8_t *fb, int white)
+{
+    memset(fb, white ? 0xFF : 0x00, EPD4G_BW_FB_BYTES);
+}
+
+void epd4g_bw_fb_set(uint8_t *fb, int x, int y, int white)
+{
+    if (x < 0 || y < 0 || x >= EPD4G_WIDTH || y >= EPD4G_HEIGHT)
+        return;
+    size_t i = (size_t)y * EPD4G_BW_STRIDE + (size_t)(x >> 3);
+    uint8_t m = (uint8_t)(0x80u >> (x & 7));
+    if (white) fb[i] |= m; else fb[i] &= (uint8_t)~m;
+}
+
+int epd4g_bw_fb_get(const uint8_t *fb, int x, int y)
+{
+    if (x < 0 || y < 0 || x >= EPD4G_WIDTH || y >= EPD4G_HEIGHT)
+        return EPD4G_BW_WHITE;
+    return (fb[(size_t)y * EPD4G_BW_STRIDE + (size_t)(x >> 3)] >> (7 - (x & 7))) & 1;
+}
+
+void epd4g_bw_fb_set_rot(uint8_t *fb, epd4g_rot_t rot, int x, int y, int white)
+{
+    int nx, ny;
+    if (epd4g_map(rot, x, y, &nx, &ny) == 0)
+        epd4g_bw_fb_set(fb, nx, ny, white);
+}
+
+int epd4g_bw_fb_get_rot(const uint8_t *fb, epd4g_rot_t rot, int x, int y)
+{
+    int nx, ny;
+    if (epd4g_map(rot, x, y, &nx, &ny) != 0)
+        return EPD4G_BW_WHITE;
+    return epd4g_bw_fb_get(fb, nx, ny);
+}
+
+void epd4g_bw_fb_copy_rect(uint8_t *dst, const uint8_t *src, const epd4g_rect_t *r)
+{
+    int x0 = r->x0 < 0 ? 0 : r->x0, x1 = r->x1 >= EPD4G_WIDTH ? EPD4G_WIDTH - 1 : r->x1;
+    int y0 = r->y0 < 0 ? 0 : r->y0, y1 = r->y1 >= EPD4G_HEIGHT ? EPD4G_HEIGHT - 1 : r->y1;
+    if (x0 > x1 || y0 > y1)
+        return;
+    for (int y = y0; y <= y1; y++) {
+        size_t o = (size_t)y * EPD4G_BW_STRIDE + (size_t)(x0 >> 3);
+        memcpy(&dst[o], &src[o], (size_t)((x1 >> 3) - (x0 >> 3) + 1));
+    }
+}
+
+/* 4 pixels of a 2-bit image byte -> 4 bits (first pixel in bit 3), 1 = pixel >= EPD4G_BW_THRESHOLD */
+static uint8_t nibble_bw(uint8_t b)
+{
+    return (uint8_t)((((b >> 6) & 3) >= EPD4G_BW_THRESHOLD ? 8 : 0) |
+                     (((b >> 4) & 3) >= EPD4G_BW_THRESHOLD ? 4 : 0) |
+                     (((b >> 2) & 3) >= EPD4G_BW_THRESHOLD ? 2 : 0) |
+                     ((b & 3)        >= EPD4G_BW_THRESHOLD ? 1 : 0));
+}
+
+void epd4g_fb_to_bw(uint8_t *bw, const uint8_t *fb)
+{
+    for (int y = 0; y < EPD4G_HEIGHT; y++) {
+        const uint8_t *in = fb + (size_t)y * EPD4G_FB_STRIDE;
+        uint8_t *out = bw + (size_t)y * EPD4G_BW_STRIDE;
+        for (int xb = 0; xb < EPD4G_BW_STRIDE; xb++)       /* 2 image bytes = 8 pixels = 1 plane byte */
+            out[xb] = (uint8_t)((nibble_bw(in[xb * 2]) << 4) | nibble_bw(in[xb * 2 + 1]));
+    }
+}
