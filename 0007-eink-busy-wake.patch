+        int nx, ny; CHECK(epd4g_map((epd4g_rot_t)rot, lw, 0, &nx, &ny) == -1 && epd4g_map((epd4g_rot_t)rot, 0, -1, &nx, &ny) == -1, "map rejects outside");
