+    CHECK(n == brute && bits == brute, "mask_from_diff count %u / %u / %u", n, bits, brute);
+
+    epd4g_fb_fill(a, EPD4G_WHITE); epd4g_fb_fill(b, EPD4G_BLACK);        /* copy_rect copies whole byte columns */
