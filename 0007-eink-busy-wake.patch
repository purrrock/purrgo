+static void test_errors(void)
+{
+    static uint8_t fb[EPD4G_FB_BYTES], mask[EPD4G_MASK_BYTES];
+    epd4g_fb_fill(fb, EPD4G_WHITE);
+    CHECK(epd4g_init() == EPD4G_OK, "init");
