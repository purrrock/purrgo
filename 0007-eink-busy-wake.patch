+__attribute__((unused)) static uint32_t stream_fnv(int from)
+{
+    uint32_t h = 2166136261u;
+    for (int i = from; i < stream_n; i++) { h ^= stream[i] & 0xFF; h *= 16777619u; h ^= stream[i] >> 8; h *= 16777619u; }
+    return h;
+}
+
+__attribute__((unused)) static uint32_t stream_fnv_to(int to)
+{
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < to && i < stream_n; i++) { h ^= stream[i] & 0xFF; h *= 16777619u; h ^= stream[i] >> 8; h *= 16777619u; }
+    return h;
+}
