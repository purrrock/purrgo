+/*
+ * Диагностика тока выключения: -DPURRGO_POWEROFF_STEP_PAUSE_MS=10000 - после
+ * каждого шага последовательности платформа ждёт указанное время (на STM32 в
+ * Stop 2) и перед паузой выдаёт метку: (номер шага + 1) коротких всплесков тока.
+ * По записи тока видно, какой шаг добавляет потребление. 0 (по умолчанию) - выкл.
+ */
+#ifndef PURRGO_POWEROFF_STEP_PAUSE_MS
+#define PURRGO_POWEROFF_STEP_PAUSE_MS 0
+#endif
+#if (PURRGO_POWEROFF_STEP_PAUSE_MS > 0)
+void purrgo_platform_debug_step(unsigned step, unsigned pause_ms);
+#define PO_STEP(n) purrgo_platform_debug_step((n), PURRGO_POWEROFF_STEP_PAUSE_MS)
+#else
+#define PO_STEP(n) ((void)0)
+#endif
+
 void purrgo_system_power_off(void)
 {
     PURRGO_LOG("Powering off...\n\r");
+    PO_STEP(0);   /* до начала последовательности */
 
     /*
      * 1. Финальный экран: последняя карта с треком и маркером и инверсные
@@ -21,24 +38,30 @@ void purrgo_system_power_off(void)
      * полный refresh e-ink занимает секунды, а данные важнее.
      */
     const bool power_off_screen = purrgo_app_ui_render_power_off();
+    PO_STEP(1);   /* экран во framebuffer */
 
     /* 2. Остановить запись трека: сброс буфера и закрытие файла. */
     purrgo_logger_stop();
