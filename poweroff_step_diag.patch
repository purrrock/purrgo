      * 7. Вывести финальный экран (на e-ink изображение остаётся без питания)
@@ -50,6 +73,7 @@ void purrgo_system_power_off(void)
     }
     display_sleep();
     PURRGO_LOG("Display off\r\n");
+    PO_STEP(7);   /* экран показан, панель в deep sleep */
 
     /* 8. Низкое энергопотребление (платформа). На железе не возвращается. */
     purrgo_platform_enter_standby();
diff --git a/stm32/port/power/power_stm32.c b/stm32/port/power/power_stm32.c
index 13bba1a..1745d9e 100644
--- a/stm32/port/power/power_stm32.c
+++ b/stm32/port/power/power_stm32.c
@@ -16,6 +16,36 @@ void purrgo_platform_storage_unmount(void)
     PURRGO_LOG("FatFs dismount\r\n");
 }
 
+#if defined(PURRGO_POWEROFF_STEP_PAUSE_MS) && (PURRGO_POWEROFF_STEP_PAUSE_MS > 0)
+/*
+ * Диагностика (см. power.c): метка из (step + 1) всплесков тока по ~0,4 с
+ * (МК в Run), затем пауза pause_ms в Stop 2 - состояние платы в этот момент
+ * видно на записи тока как ровная полка.
+ */
+void purrgo_platform_debug_step(unsigned step, unsigned pause_ms)
+{
+    PURRGO_LOG("POWEROFF STEP %u\r\n", step);
+
+    for (unsigned i = 0U; i <= step; i++)
+    {
+        HAL_Delay(400U);
+        if (!purrgo_stop2_enter(600U))
+        {
+            HAL_Delay(600U);
+        }
+    }
+
+    const uint32_t t0 = HAL_GetTick();
+    while ((HAL_GetTick() - t0) < pause_ms)
+    {
+        if (!purrgo_stop2_enter(1000U))
+        {
+            HAL_Delay(100U);
+        }
+    }
+}
+#endif
+
 /*
  * 1 - POWER OFF через Stop 2 (пробуждение K1 -> сброс). 0 - Standby.
  * Замеры (Release): Standby 5,17 мА, Stop 2 в читалке 2,75 мА на той же плате
