diff --git a/stm32/port/app/stm32_app.c b/stm32/port/app/stm32_app.c
index 8efe77f..d0e390c 100644
--- a/stm32/port/app/stm32_app.c
+++ b/stm32/port/app/stm32_app.c
@@ -118,6 +118,30 @@ static void process_buttons(void)
 static void purrgo_stm32_idle(uint32_t now_ms)
 {
 #if (PURRGO_STOP2 != 0)
+#if (PURRGO_STOP2_DUMP != 0)
+  /*
+   * Диагностика: те же три условия, но вычисляются все и по смене набора печатается
+   * строка с временем - видно, что и как долго не пускает МК в Stop 2.
+   */
+  {
+    static int s_prev_mask = -1;
+    const bool app_ok = purrgo_app_deep_sleep_allowed(now_ms);
+    const bool disp_ok = display_stm32_can_stop();
+    const bool btn_ok = purrgo_stm32_buttons_idle();
+    const int mask = (app_ok ? 1 : 0) | (disp_ok ? 2 : 0) | (btn_ok ? 4 : 0);
+
+    if (mask != s_prev_mask)
+    {
+      s_prev_mask = mask;
+      PURRGO_LOGE("S2D idle t=%lu app=%d disp=%d btn=%d\r\n", (unsigned long)HAL_GetTick(),
+                  app_ok ? 1 : 0, disp_ok ? 1 : 0, btn_ok ? 1 : 0);
+    }
+    if (app_ok && disp_ok && btn_ok && purrgo_stop2_enter(PURRGO_STOP2_MAX_MS))
+    {
+      return;
+    }
+  }
+#else
   if (purrgo_app_deep_sleep_allowed(now_ms) &&
       display_stm32_can_stop() &&
       purrgo_stm32_buttons_idle())
@@ -127,6 +151,7 @@ static void purrgo_stm32_idle(uint32_t now_ms)
       return;
     }
   }
+#endif
 #else
   (void)now_ms;
 #endif
