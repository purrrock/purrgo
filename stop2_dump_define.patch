diff --git a/stm32/port/power/stop_mode.c b/stm32/port/power/stop_mode.c
index 97bee25..2dcd945 100644
--- a/stm32/port/power/stop_mode.c
+++ b/stm32/port/power/stop_mode.c
@@ -86,6 +86,41 @@ static bool lptim_wait_flag(uint32_t flag)
     return n != 0U;
 }
 
+#if (PURRGO_STOP2_DUMP != 0)
+static void dump_gpio(const char *tag, char port, const GPIO_TypeDef *g)
+{
+    PURRGO_LOGE("S2D %s GPIO%c MODER=%08lX OTYPER=%04lX PUPDR=%08lX ODR=%04lX IDR=%04lX "
+                "AFRL=%08lX AFRH=%08lX\r\n",
+                tag, port, (unsigned long)g->MODER, (unsigned long)g->OTYPER,
+                (unsigned long)g->PUPDR, (unsigned long)g->ODR, (unsigned long)g->IDR,
+                (unsigned long)g->AFR[0], (unsigned long)g->AFR[1]);
+}
+
+void purrgo_stop2_dump_state(const char *tag)
+{
+    dump_gpio(tag, 'A', GPIOA);
+    dump_gpio(tag, 'B', GPIOB);
+    dump_gpio(tag, 'C', GPIOC);
+
+    PURRGO_LOGE("S2D %s RCC CR=%08lX CFGR1=%08lX AHB1=%08lX AHB2_1=%08lX AHB2_2=%08lX "
+                "AHB3=%08lX\r\n",
+                tag, (unsigned long)RCC->CR, (unsigned long)RCC->CFGR1,
+                (unsigned long)RCC->AHB1ENR, (unsigned long)RCC->AHB2ENR1,
+                (unsigned long)RCC->AHB2ENR2, (unsigned long)RCC->AHB3ENR);
+    PURRGO_LOGE("S2D %s RCC APB1_1=%08lX APB1_2=%08lX APB2=%08lX APB3=%08lX SRDAMR=%08lX "
+                "CCIPR1=%08lX CCIPR3=%08lX\r\n",
+                tag, (unsigned long)RCC->APB1ENR1, (unsigned long)RCC->APB1ENR2,
+                (unsigned long)RCC->APB2ENR, (unsigned long)RCC->APB3ENR,
+                (unsigned long)RCC->SRDAMR, (unsigned long)RCC->CCIPR1,
+                (unsigned long)RCC->CCIPR3);
+    PURRGO_LOGE("S2D %s PWR CR1=%08lX CR2=%08lX CR3=%08lX VOSR=%08lX SVMCR=%08lX "
+                "SVMSR=%08lX\r\n",
+                tag, (unsigned long)PWR->CR1, (unsigned long)PWR->CR2,
+                (unsigned long)PWR->CR3, (unsigned long)PWR->VOSR,
+                (unsigned long)PWR->SVMCR, (unsigned long)PWR->SVMSR);
+}
+#endif
+
 bool purrgo_stop2_init(void)
 {
     __HAL_RCC_PWR_CLK_ENABLE();
@@ -270,6 +305,18 @@ bool purrgo_stop2_enter(uint32_t max_ms)
         PURRGO_LOG("Stop2: first entry, wake period <= %lu ms\r\n", (unsigned long)max_ms);
     }
 
+#if (PURRGO_STOP2_DUMP != 0)
+    /* Состояние перед первым сном в читалке: эталон для сравнения с POWEROFF. */
+    {
+        static bool s_dumped;
+        if (!s_dumped)
+        {
+            s_dumped = true;
+            purrgo_stop2_dump_state("BOOK");
+        }
+    }
+#endif
+
     __disable_irq();
 
     if (!arm_buttons() || !arm_timer(ticks))
@@ -323,6 +370,7 @@ bool purrgo_stop2_power_off(void)
     }
 
     PURRGO_LOG("Stop2: power off, wake by K1 only (then reset)\r\n");
+    purrgo_stop2_dump_state("POWEROFF");
 
     GPIO_InitTypeDef gpio = {0};
     gpio.Pin = K1_Pin;
diff --git a/stm32/port/power/stop_mode.h b/stm32/port/power/stop_mode.h
index 6e00bd9..70c774f 100644
--- a/stm32/port/power/stop_mode.h
+++ b/stm32/port/power/stop_mode.h
@@ -41,4 +41,28 @@ bool purrgo_stop2_enter(uint32_t max_ms);
  */
 bool purrgo_stop2_power_off(void);
 
+/*
+ * Диагностика сна: 1 - включена, 0 - выключена (для штатной сборки поставить 0).
+ * При 1 в UART печатаются строки "S2D ..." уровнем ERROR (видны и в Release, где
+ * PURRGO_LOG_LEVEL=1; светодиод PC13 при этом не мигает):
+ *   - "S2D BOOK ..." / "S2D POWEROFF ..." - регистры GPIOA..C, RCC и PWR перед первым
+ *     сном в читалке и перед сном при выключении (сравнить: различие - причина разницы
+ *     состояний, см. purrgo_stop2_dump_state());
+ *   - "S2D idle t=... app= disp= btn=" - при каждой смене условий входа в Stop 2
+ *     (приложение, дисплей, кнопки), t - HAL_GetTick(), мс: видно, что и сколько держит
+ *     МК бодрствующим после обновления панели;
+ *   - "S2D eink op=... t=..." - завершение операции панели (0 NONE, 1 INIT, 2 FULL,
+ *     3 PARTIAL, 4 SLEEP), t - HAL_GetTick(), мс.
+ */
+#ifndef PURRGO_STOP2_DUMP
+#define PURRGO_STOP2_DUMP 1
+#endif
+
+#if (PURRGO_STOP2_DUMP != 0)
+/* Регистры GPIOA..C, RCC, PWR одной серией строк "S2D <tag> ...". */
+void purrgo_stop2_dump_state(const char *tag);
+#else
+#define purrgo_stop2_dump_state(tag) ((void)(tag))
+#endif
+
 #endif /* PURRGO_STOP_MODE_H */
