@@ -18,6 +18,21 @@
  */
 void purrgo_system_power_off(void);
 
+/*
+ * Диагностика тока выключения. Чтобы включить, поменять значение ниже (мс) и
+ * пересобрать: после каждого шага purrgo_system_power_off() платформа выдаёт
+ * метку ((номер шага + 1) коротких всплесков тока), затем ждёт это время (на
+ * STM32 в Stop 2). По записи тока видно, какой шаг добавляет потребление.
+ * 0 - выключено (штатная работа). Переопределяется и флагом -D при сборке.
+ */
+#ifndef PURRGO_POWEROFF_STEP_PAUSE_MS
+#define PURRGO_POWEROFF_STEP_PAUSE_MS 0   /* <-- для диагностики, например, 10000 */
+#endif
+
+#if (PURRGO_POWEROFF_STEP_PAUSE_MS > 0)
+void purrgo_platform_debug_step(unsigned step, unsigned pause_ms);
+#endif
+
 /*
  * Platform hooks used by purrgo_system_power_off().
  */
