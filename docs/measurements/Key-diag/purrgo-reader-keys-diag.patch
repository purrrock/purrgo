     return false;
 }
 
+/*
+ * Диагностика (только Debug, PURRGO_LOGD): что читалка сделала с кнопкой. Если после записи
+ * "BUTTON KEYx SHORT" строки "BOOK: btn" нет, событие не дошло до читалки; если redraw=0 -
+ * читалка его отвергла (причина: find/jump/active/open в той же строке).
+ */
+bool purrgo_book_reader_handle_button(purrgo_state_t state, purrgo_btn_t button,
+                                      purrgo_state_t *next_state)
+{
+    purrgo_state_t next = state;
+    const uint32_t page_before = s.page;
+    const bool redraw = reader_handle_button(state, button, &next);
+
+    if (next_state != NULL) {
+        *next_state = next;
+    }
+    PURRGO_LOGD("[%lu] BOOK: btn=%d state=%d->%d redraw=%d page=%lu->%lu/%lu act=%d open=%d find=%d jump=%d\r\n",
+                (unsigned long)purrgo_system_time_ms(), (int)button, (int)state, (int)next,
+                (int)redraw, (unsigned long)page_before, (unsigned long)s.page,
+                (unsigned long)s.hdr.page_count, (int)s.active, (int)s.open, (int)s.find,
+                (int)s.jump);
+    return redraw;
+}
