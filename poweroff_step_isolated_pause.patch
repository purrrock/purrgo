diff --git a/stm32/port/power/stop_mode.c b/stm32/port/power/stop_mode.c
index 6abef30..b2e58f5 100644
--- a/stm32/port/power/stop_mode.c
+++ b/stm32/port/power/stop_mode.c
@@ -302,6 +302,75 @@ bool purrgo_stop2_enter(uint32_t max_ms)
     return true;
 }
 
+bool purrgo_stop2_pause(uint32_t max_ms)
+{
+    if (!s_ready)
+    {
+        return false;
+    }
+
+    uint32_t ticks = max_ms / ((LPTIM_PRESC_DIV * 1000U) / PURRGO_STOP_LSI_HZ);
+    if (ticks < LPTIM_MIN_WAKE_TICKS)
+    {
+        ticks = LPTIM_MIN_WAKE_TICKS;
+    }
+    if (ticks > (LPTIM_ARR / 2U))
+    {
+        ticks = LPTIM_ARR / 2U;
+    }
+
+    uint32_t saved[sizeof(NVIC->ISER) / sizeof(NVIC->ISER[0])];
+
+    __disable_irq();
+
+    /* Запомнить и снять все линии NVIC: будить должен только LPTIM1. */
+    for (uint32_t i = 0U; i < (sizeof(NVIC->ISER) / sizeof(NVIC->ISER[0])); i++)
+    {
+        saved[i] = NVIC->ISER[i];
+        NVIC->ICER[i] = 0xFFFFFFFFU;
+        NVIC->ICPR[i] = 0xFFFFFFFFU;
+    }
+
+    if (!arm_timer(ticks))
+    {
+        disarm_timer();
+        for (uint32_t i = 0U; i < (sizeof(NVIC->ISER) / sizeof(NVIC->ISER[0])); i++)
+        {
+            NVIC->ISER[i] = saved[i];
+        }
+        __enable_irq();
+        return false;
+    }
+
+    const uint16_t t0 = lptim_count();
+
+    HAL_SuspendTick();
+    SCB->ICSR = SCB_ICSR_PENDSTCLR_Msk;
+
+    HAL_PWREx_EnterSTOP2Mode(PWR_STOPENTRY_WFI);
+
+    const uint16_t t1 = lptim_count();
+
+    disarm_timer();
+    HAL_ResumeTick();
+    for (uint32_t i = 0U; i < (sizeof(NVIC->ISER) / sizeof(NVIC->ISER[0])); i++)
+    {
+        NVIC->ISER[i] = saved[i];
+    }
+    __enable_irq();
+
+    SystemClock_Config();
+
+    const uint32_t dticks = (uint32_t)(uint16_t)(t1 - t0);
+    const uint32_t elapsed_ms = (uint32_t)(((uint64_t)dticks * LPTIM_PRESC_DIV * 1000U)
+                                           / PURRGO_STOP_LSI_HZ);
+    __disable_irq();
+    uwTick += elapsed_ms;
+    __enable_irq();
+
+    return true;
+}
