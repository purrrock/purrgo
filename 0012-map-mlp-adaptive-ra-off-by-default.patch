From a77765ed7c03431a97944a0e8fed1c5b3b5ce59c Mon Sep 17 00:00:00 2001
From: claude <claude@example.com>
Date: Wed, 18 Nov 2026 13:34:38 +0000
Subject: [PATCH] map: .mlp adaptive read-ahead off by default (hardware A/B:
 no gain)

---
 src/core/map/map_internal.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/core/map/map_internal.h b/src/core/map/map_internal.h
index 5995193..c214c4a 100644
--- a/src/core/map/map_internal.h
+++ b/src/core/map/map_internal.h
@@ -28,11 +28,13 @@
  * 20 МГц).
  *
  * PURRGO_MAP_MLP_ADAPTIVE_RA 1: адаптивный режим, как для .idx (блок 1 -> 2 -> 4, растёт только
- * пока промахи идут подряд). 0: прежний фиксированный блок. Для A/B-сравнения на железе.
+ * пока промахи идут подряд). 0 (по умолчанию): фиксированный блок. Замер на железе (prof1.log):
+ * адаптивный режим читает на 15-30% меньше секторов, но на 30-50% больше команд (441 мкс на
+ * команду ~ 1,9 сектора), итог по времени кадра в пределах шума или чуть хуже.
  */
 #define PURRGO_MAP_MLP_READ_AHEAD_SECTORS 4u
 #ifndef PURRGO_MAP_MLP_ADAPTIVE_RA
-#define PURRGO_MAP_MLP_ADAPTIVE_RA 1
+#define PURRGO_MAP_MLP_ADAPTIVE_RA 0
 #endif
 
