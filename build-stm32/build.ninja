build apps/stm32/PurrGO_STM32/cmake/stm32cubemx/all: phony apps/stm32/PurrGO_STM32/cmake/stm32cubemx/STM32_Drivers

# =============================================================================

#############################################
# Folder: D:/purrgo/build-stm32/third_party

build third_party/all: phony third_party/libminmea.a

# =============================================================================
# Built-in targets


#############################################
# Phony target to force glob verification run.

build D$:/purrgo/build-stm32/CMakeFiles/VerifyGlobs.cmake_force: phony


#############################################
# Re-run CMake to check if globbed directories changed.

build D$:/purrgo/build-stm32/CMakeFiles/cmake.verify_globs: VERIFY_GLOBS | D$:/purrgo/build-stm32/CMakeFiles/VerifyGlobs.cmake_force
  pool = console
  restat = 1


