build STM32_Drivers: phony apps/stm32/PurrGO_STM32/cmake/stm32cubemx/STM32_Drivers

build libminmea.a: phony third_party/libminmea.a

build minmea: phony third_party/libminmea.a

build purrgo_core: phony libpurrgo_core.a

build purrgo_ublox7: phony libpurrgo_ublox7.a

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/purrgo/build-stm32

build all: phony libpurrgo_core.a libpurrgo_ublox7.a third_party/all apps/stm32/PurrGO_STM32/all

# =============================================================================

#############################################
# Folder: D:/purrgo/build-stm32/apps/stm32/PurrGO_STM32

build apps/stm32/PurrGO_STM32/all: phony apps/stm32/PurrGO_STM32/PurrGO_STM32.elf apps/stm32/PurrGO_STM32/cmake/stm32cubemx/all

# =============================================================================

#############################################
