diff --git a/include/purrgo/supply.h b/include/purrgo/supply.h
index 63c24f9..6d7e8c0 100644
--- a/include/purrgo/supply.h
+++ b/include/purrgo/supply.h
@@ -26,6 +26,10 @@
  * подгружается и книги читаются. Процессор и GNSS тоже работают, пока хватает
  * питания: приёмник не выключается, экран и позиция обновляются.
  *
+ * Пользователь узнаёт о стопе записи до потери трека: причина (VDD, батарея или
+ * обе) выводится постоянным индикатором на карте и в путевом компьютере, а не
+ * только в строке статуса ("LOW") и в UART.
+ *
  * Возврат к норме:
  *   - причина 1 (PVD): после PURRGO_SUPPLY_RECOVER_MS непрерывно нормального
  *     напряжения запись разрешается, трек стартует как новая сессия (новый файл);
@@ -63,12 +67,43 @@ bool purrgo_platform_supply_low(void);
 #define PURRGO_SUPPLY_BATT_CONFIRM_POLLS 3u
 #endif
 
-/* Периодический опрос из purrgo_app_tick(). true - состояние блокировки изменилось. */
+/*
+ * Причины блокировки записи (битовая маска; могут действовать обе сразу).
+ * Единая точка для UI: экраны карты и путевого компьютера рисуют индикатор
+ * только по purrgo_supply_storage_blocked() и purrgo_supply_reason_text().
+ */
+typedef enum {
+    PURRGO_SUPPLY_REASON_NONE = 0u,
+    PURRGO_SUPPLY_REASON_VDD  = 1u << 0,   /* VDD ниже порога безопасной записи (PVD) */
+    PURRGO_SUPPLY_REASON_BATT = 1u << 1    /* батареи ниже порога источника питания (АЦП) */
+} purrgo_supply_reason_t;
+
+/*
+ * Периодический опрос из purrgo_app_tick(). true - изменилось то, что видит
+ * пользователь: состояние блокировки или набор причин (пока блокировка держится,
+ * к VDD может добавиться батарея и наоборот).
+ */
 bool purrgo_supply_tick(uint32_t now_ms);
 
 /* true - запись на карту заблокирована из-за низкого напряжения. */
 bool purrgo_supply_storage_blocked(void);
 
+/*
+ * Причины текущей блокировки (маска purrgo_supply_reason_t); 0, если запись не
+ * заблокирована. Пока идёт отсчёт возврата к норме (PURRGO_SUPPLY_RECOVER_MS),
+ * показываются последние действовавшие причины.
+ */
+uint8_t purrgo_supply_reason(void);
+
+/*
+ * Текст причин для индикатора на экране; пустая строка, если запись не
+ * заблокирована. Строка статическая, живёт до следующего изменения причин.
+ *   compact = false: "VDD", "BATT", "BATT+VDD";
+ *   compact = true:  "VDD", "BAT", "B+V" (не больше 3 символов - для строки
+ *                    статуса карты, где мало места).
+ */
+const char* purrgo_supply_reason_text(bool compact);
+
 /* Забыть состояние (инициализация приложения, тесты). */
 void purrgo_supply_reset(void);
 
