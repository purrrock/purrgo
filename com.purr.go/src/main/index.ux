<template>
  <div class="container">
    <text class="title">Geolocation</text>
    <text class="coords">{{ latitude }}</text>
    <text class="coords">{{ longitude }}</text>
    <text class="log">{{ logMessage }}</text>
    <input type="button" value="Update" class="btn" onclick="fetchLocation" />
  </div>
</template>

<style>
  .container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    background-color: #000000;
  }
  .title {
    color: #ffffff;
    font-size: 32px;
    margin-bottom: 20px;
  }
  .coords {
    color: #00ff00;
    font-size: 40px;
    margin-bottom: 10px;
  }
  .log {
    color: #aaaaaa;
    font-size: 24px;
    margin-top: 20px;
    text-align: center;
    padding: 0 20px;
  }
  .btn {
    margin-top: 30px;
    width: 200px;
    height: 60px;
    background-color: #333333;
    color: #ffffff;
    font-size: 28px;
    border-radius: 30px;
  }
</style>

<script>
  import geolocation from '@system.geolocation';

  export default {
    data: {
      latitude: 'Lat: --',
      longitude: 'Lon: --',
      logMessage: 'Ready'
    },

    onInit() {
      console.info('PurrGo: App initialized, ready to fetch location.');
    },

    onReady() {
      this.fetchLocation();
    },

    async fetchLocation() {
      this.logMessage = 'Fetching location...';
      console.info('PurrGo: Calling @system.geolocation.getLocation...');
      
      try {
        const location = await geolocation.getLocation({
          mode: 'fine',
          timeout: 30000
        });

        console.info('PurrGo: geolocation.getLocation resolved. Payload:', JSON.stringify(location));

        // Defensive parsing as per Glyphix OS constraints mentioned in memory
        let lat = undefined;
        let lon = undefined;

        if (location) {
          if (typeof location.latitude !== 'undefined') {
             lat = location.latitude;
             lon = location.longitude;
          } else if (location.data && typeof location.data.latitude !== 'undefined') {
             lat = location.data.latitude;
             lon = location.data.longitude;
          }
        }

        if (lat !== undefined && lon !== undefined) {
          this.latitude = `Lat: ${lat}`;
          this.longitude = `Lon: ${lon}`;
          this.logMessage = 'Success';
          console.info(`PurrGo: Coordinates parsed successfully. Lat: ${lat}, Lon: ${lon}`);
        } else {
          this.logMessage = 'Invalid payload format';
          console.error('PurrGo: Failed to parse coordinates from payload.', location);
        }

      } catch (error) {
        console.error('PurrGo: geolocation.getLocation rejected with error:', error);
        let errorMsg = 'Unknown error';
        if (error) {
          errorMsg = typeof error === 'object' ? JSON.stringify(error) : String(error);
        }
        this.logMessage = `Error: ${errorMsg}`;
      }
    }
  };
</script>
