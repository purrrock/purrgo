diff --git a/apps/stm32/PurrGO_STM32U5/Core/Src/main.c b/apps/stm32/PurrGO_STM32U5/Core/Src/main.c
index 01091aa..3b44895 100644
--- a/apps/stm32/PurrGO_STM32U5/Core/Src/main.c
+++ b/apps/stm32/PurrGO_STM32U5/Core/Src/main.c
@@ -76,6 +76,25 @@ int main(void)
 
   /* USER CODE BEGIN 1 */
 
+  /*
+   * Маяк запуска (временная диагностика пробуждения из Standby): 3 вспышки
+   * Alive_LED (PC13, горит низким уровнем) САМЫМ первым действием, до HAL_Init
+   * и до тактирования от PLL, на регистрах. Видны без UART-адаптера: если после
+   * нажатия K1 в Standby вспышек нет, МК не проснулся; если есть, пробуждение
+   * работает, а зависание позже. Тактирование MSI после сброса около 4 МГц,
+   * задержка примерно 0,15 с. Удалить после проверки.
+   */
+  RCC->AHB2ENR1 |= RCC_AHB2ENR1_GPIOCEN;
+  (void)RCC->AHB2ENR1;
+  GPIOC->MODER = (GPIOC->MODER & ~(3UL << (13U * 2U))) | (1UL << (13U * 2U));
+  for (uint32_t blink = 0U; blink < 3U; blink++)
+  {
+    GPIOC->BSRR = (1UL << (13U + 16U));   /* LED вкл */
+    for (volatile uint32_t d = 0U; d < 150000UL; d++) { }
+    GPIOC->BSRR = (1UL << 13U);           /* LED выкл */
+    for (volatile uint32_t d = 0U; d < 150000UL; d++) { }
+  }
+
   /* USER CODE END 1 */
 
   /* MCU Configuration--------------------------------------------------------*/
