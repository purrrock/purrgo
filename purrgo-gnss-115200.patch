+    CHECK(purrgo_gnss_receiver_build_baud(out, 19, 115200U) == 0);
+    CHECK(purrgo_gnss_receiver_build_baud(NULL, 32, 115200U) == 0);
+    CHECK(purrgo_gnss_receiver_build_baud(out, sizeof out, 0U) == 0);
