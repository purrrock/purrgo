diff --git a/apps/stm32/common/gnss_link/gnss_link.c b/apps/stm32/common/gnss_link/gnss_link.c
new file mode 100644
index 0000000..e0a9722
--- /dev/null
+++ b/apps/stm32/common/gnss_link/gnss_link.c
@@ -0,0 +1,234 @@
+/*
+ * Установление связи с GNSS-модулем: определение скорости UART и смена скорости.
+ * См. gnss_link.h.
+ */
+
+#include "gnss_link.h"
+
+#include <stddef.h>
+
+#define PROBED_DEFAULT 0x01U
+#define PROBED_TARGET  0x02U
+
+static uint8_t probed_bit(const gnss_link_t *l, uint32_t baud)
+{
+    return (baud == l->cfg.default_baud) ? PROBED_DEFAULT : PROBED_TARGET;
+}
+
+static bool elapsed(const gnss_link_t *l, uint32_t now_ms, uint32_t ms)
+{
+    return (uint32_t)(now_ms - l->t0) >= ms;
+}
+
+static void notify(gnss_link_t *l)
+{
+    if (l->ops.on_state != NULL)
+    {
+        l->ops.on_state(l->state, l->baud, l->ops.ctx);
+    }
+}
+
+/* Итоговое состояние. FAILED и DEGRADED оставляют UART на заводской скорости. */
+static void finish(gnss_link_t *l, gnss_link_state_t state)
+{
+    if ((state != GNSS_LINK_READY) && (l->baud != l->cfg.default_baud))
+    {
+        (void)l->ops.set_baud(l->cfg.default_baud, l->ops.ctx);
+        l->baud = l->cfg.default_baud;
+    }
+    l->state = state;
+    notify(l);
+}
+
+/* Слушать на скорости baud. Ошибка перенастройки UART - сразу FAILED. */
+static void enter_probe(gnss_link_t *l, uint32_t baud, uint32_t now_ms)
+{
+    if (!l->ops.set_baud(baud, l->ops.ctx))
+    {
+        l->state = GNSS_LINK_FAILED;
+        notify(l);
+        return;
+    }
+    l->baud = baud;
+    l->probed |= probed_bit(l, baud);
+    gnss_diag_init(&l->diag);
+    l->t0 = now_ms;
+    l->state = GNSS_LINK_PROBE;
+    notify(l);
+}
+
+void gnss_link_init(gnss_link_t *l, const gnss_link_cfg_t *cfg, const gnss_link_ops_t *ops)
+{
+    if ((l == NULL) || (cfg == NULL) || (ops == NULL))
+    {
+        return;
+    }
+    l->cfg = *cfg;
+    l->ops = *ops;
+    l->state = GNSS_LINK_IDLE;
+    l->baud = cfg->default_baud;
+    l->t0 = 0U;
+    l->probed = 0U;
+    l->cycles = 0U;
+    l->switch_tries = 0U;
+    gnss_diag_init(&l->diag);
+}
+
+void gnss_link_start(gnss_link_t *l, uint32_t now_ms)
+{
+    if ((l == NULL) || (l->ops.set_baud == NULL) || (l->ops.send_baud_cmd == NULL))
+    {
+        return;
+    }
+    l->probed = 0U;
+    l->cycles = 0U;
+    l->switch_tries = 0U;
+    enter_probe(l, l->cfg.default_baud, now_ms);
+}
+
+void gnss_link_stop(gnss_link_t *l)
+{
+    if (l != NULL)
+    {
+        l->state = GNSS_LINK_IDLE;
+    }
+}
+
+void gnss_link_feed(gnss_link_t *l, uint8_t byte)
+{
+    if ((l == NULL) ||
+        ((l->state != GNSS_LINK_PROBE) && (l->state != GNSS_LINK_VERIFY)))
+    {
+        return;
+    }
+    gnss_diag_feed(&l->diag, byte);
+}
+
+static void poll_probe(gnss_link_t *l, uint32_t now_ms)
+{
+    if (l->diag.sentences_ok != 0U)
+    {
+        if (l->baud == l->cfg.target_baud)
+        {
+            finish(l, GNSS_LINK_READY);
+            return;
+        }
+
+        /* Модуль на заводской скорости, рабочая другая: сменить скорость. */
+        if ((l->switch_tries >= l->cfg.attempts) ||
+            !l->ops.send_baud_cmd(l->cfg.target_baud, l->ops.ctx))
+        {
+            finish(l, GNSS_LINK_DEGRADED);
+            return;
+        }
+        l->switch_tries++;
+        l->t0 = now_ms;
+        l->state = GNSS_LINK_SWITCH;
+        notify(l);
+        return;
+    }
+
+    if (!elapsed(l, now_ms, l->cfg.probe_ms))
+    {
+        return;
+    }
+
+    /* Тишина на этой скорости: попробовать другую; обе без ответа - цикл закончен. */
+    const uint32_t other = (l->baud == l->cfg.default_baud) ? l->cfg.target_baud
+                                                              : l->cfg.default_baud;
+
+    if ((l->probed & probed_bit(l, other)) == 0U)
+    {
+        enter_probe(l, other, now_ms);
+        return;
+    }
+
+    l->cycles++;
+    if (l->cycles >= l->cfg.attempts)
+    {
+        finish(l, GNSS_LINK_FAILED);
+        return;
+    }
+    l->probed = 0U;
+    enter_probe(l, l->cfg.default_baud, now_ms);
+}
+
+void gnss_link_poll(gnss_link_t *l, uint32_t now_ms)
+{
+    if (l == NULL)
+    {
+        return;
+    }
+
+    switch (l->state)
+    {
+    case GNSS_LINK_PROBE:
+        poll_probe(l, now_ms);
+        break;
+
+    case GNSS_LINK_SWITCH:
+        if (elapsed(l, now_ms, l->cfg.settle_ms))
+        {
+            if (!l->ops.set_baud(l->cfg.target_baud, l->ops.ctx))
+            {
+                l->state = GNSS_LINK_FAILED;
+                notify(l);
+                break;
+            }
+            l->baud = l->cfg.target_baud;
+            gnss_diag_init(&l->diag);
+            l->t0 = now_ms;
+            l->state = GNSS_LINK_VERIFY;
+            notify(l);
+        }
+        break;
+
+    case GNSS_LINK_VERIFY:
+        if (l->diag.sentences_ok != 0U)
+        {
+            finish(l, GNSS_LINK_READY);
+        }
+        else if (elapsed(l, now_ms, l->cfg.probe_ms))
+        {
+            /* Модуль не заговорил на новой скорости: назад на заводскую. */
+            l->probed = 0U;
+            enter_probe(l, l->cfg.default_baud, now_ms);
+        }
+        break;
+
+    default:
+        break;
+    }
+}
+
+gnss_link_state_t gnss_link_state(const gnss_link_t *l)
+{
+    return (l != NULL) ? l->state : GNSS_LINK_IDLE;
+}
+
+uint32_t gnss_link_baud(const gnss_link_t *l)
+{
+    return (l != NULL) ? l->baud : 0U;
+}
+
+bool gnss_link_busy(const gnss_link_t *l)
+{
+    return (l != NULL) &&
+           ((l->state == GNSS_LINK_PROBE) || (l->state == GNSS_LINK_SWITCH) ||
+            (l->state == GNSS_LINK_VERIFY));
+}
+
+const char *gnss_link_state_name(gnss_link_state_t state)
+{
+    switch (state)
+    {
+    case GNSS_LINK_IDLE:     return "IDLE";
+    case GNSS_LINK_PROBE:    return "PROBE";
+    case GNSS_LINK_SWITCH:   return "SWITCH";
+    case GNSS_LINK_VERIFY:   return "VERIFY";
+    case GNSS_LINK_READY:    return "READY";
+    case GNSS_LINK_DEGRADED: return "DEGRADED";
+    case GNSS_LINK_FAILED:   return "FAILED";
+    default:                 return "?";
+    }
+}
diff --git a/apps/stm32/common/gnss_link/gnss_link.h b/apps/stm32/common/gnss_link/gnss_link.h
new file mode 100644
index 0000000..26a93cd
--- /dev/null
+++ b/apps/stm32/common/gnss_link/gnss_link.h
@@ -0,0 +1,117 @@
+#ifndef PURRGO_GNSS_LINK_H
+#define PURRGO_GNSS_LINK_H
+
+/*
+ * Установление связи с GNSS-модулем: определение скорости UART и переход с
+ * заводской скорости модуля на рабочую.
+ *
+ * Модуль после включения работает на заводской скорости (G10A F30: 38400), а
+ * после сброса одного МК (без выключения модуля) может оставаться на рабочей.
+ * Алгоритм (все ожидания - без блокировки, по gnss_link_poll()):
+ *
+ *   PROBE   слушать на одной скорости probe_ms; корректное предложение NMEA
+ *           (верная контрольная сумма) - модуль найден.
+ *             * это рабочая скорость            -> READY;
+ *             * это заводская, рабочая другая   -> отправить команду смены
+ *               скорости, SWITCH;
+ *             * тишина                          -> другая скорость (рабочая
+ *               после заводской и наоборот); обе без ответа - новый цикл.
+ *   SWITCH  пауза settle_ms, чтобы модуль применил скорость, затем UART на
+ *           рабочую скорость.
+ *   VERIFY  слушать на рабочей скорости; NMEA есть -> READY; нет -> вернуться
+ *           на заводскую (PROBE): модуль не переключился, команду можно
+ *           повторить.
+ *   READY     связь на рабочей скорости (можно отправлять настройку NMEA);
+ *   DEGRADED  модуль отвечает, но не переключается (после attempts команд):
+ *             работа на заводской скорости;
+ *   FAILED    модуль молчит на обеих скоростях attempts циклов подряд: UART
+ *             остаётся на заводской скорости (диагностика - gnss_monitor).
+ *
+ * Модуль не зависит от HAL и ядра PurrGO: UART и команды приёмника подключаются
+ * функциями (gnss_link_ops_t), поэтому логика проверяется host-тестом
+ * (tests/host/test_gnss_link.c). Все функции вызываются из основного цикла.
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "gnss_diag.h"
+
+typedef enum
+{
+    GNSS_LINK_IDLE = 0,   /* не запущен (GNSS выключен) */
+    GNSS_LINK_PROBE,
+    GNSS_LINK_SWITCH,
+    GNSS_LINK_VERIFY,
+    GNSS_LINK_READY,
+    GNSS_LINK_DEGRADED,
+    GNSS_LINK_FAILED
+} gnss_link_state_t;
+
+typedef struct
+{
+    /* Перенастроить UART на скорость и перезапустить приём; false - ошибка железа. */
+    bool (*set_baud)(uint32_t baud, void *ctx);
+    /*
+     * Отправить модулю команду смены скорости на baud; вернуться после полной
+     * передачи. false - команду отправить нельзя (модель не умеет, ошибка TX).
+     */
+    bool (*send_baud_cmd)(uint32_t baud, void *ctx);
+    /* Смена состояния; baud - скорость UART в этом состоянии. Может быть NULL. */
+    void (*on_state)(gnss_link_state_t state, uint32_t baud, void *ctx);
+    void *ctx;
+} gnss_link_ops_t;
+
+typedef struct
+{
+    uint32_t default_baud;   /* заводская скорость модуля */
+    uint32_t target_baud;    /* рабочая скорость (может совпадать с default_baud) */
+    uint32_t probe_ms;       /* сколько слушать на одной скорости (>= 1100 при 1 Гц) */
+    uint32_t settle_ms;      /* пауза после команды смены скорости */
+    uint8_t attempts;        /* попыток смены скорости и циклов поиска (>= 1) */
+} gnss_link_cfg_t;
+
+typedef struct
+{
+    gnss_link_cfg_t cfg;
+    gnss_link_ops_t ops;
+    gnss_link_state_t state;
+    uint32_t baud;           /* текущая скорость UART */
+    uint32_t t0;             /* начало текущего ожидания, мс */
+    uint8_t probed;          /* скорости, прослушанные в этом цикле (1 - заводская, 2 - рабочая) */
+    uint8_t cycles;          /* циклов поиска без ответа */
+    uint8_t switch_tries;    /* отправленных команд смены скорости */
+    gnss_diag_t diag;        /* разбор NMEA, пока идёт поиск */
+} gnss_link_t;
+
+/** @brief Подготовить структуру (состояние IDLE). */
+void gnss_link_init(gnss_link_t *l, const gnss_link_cfg_t *cfg, const gnss_link_ops_t *ops);
+
+/**
+ * @brief Начать поиск: UART на заводскую скорость, слушать. Вызывать после
+ *        включения модуля (EN в High) и запуска приёма.
+ */
+void gnss_link_start(gnss_link_t *l, uint32_t now_ms);
+
+/** @brief Остановить (GNSS выключен): состояние IDLE, байты игнорируются. */
+void gnss_link_stop(gnss_link_t *l);
+
+/** @brief Учесть принятый байт (только PROBE и VERIFY, иначе сразу возврат). */
+void gnss_link_feed(gnss_link_t *l, uint8_t byte);
+
+/** @brief Продвинуть автомат (таймауты, переходы). Вызывать из основного цикла. */
+void gnss_link_poll(gnss_link_t *l, uint32_t now_ms);
+
+gnss_link_state_t gnss_link_state(const gnss_link_t *l);
+
+/** @brief Текущая скорость UART. */
+uint32_t gnss_link_baud(const gnss_link_t *l);
+
+/** @brief true, пока идёт поиск или смена скорости (PROBE, SWITCH, VERIFY). */
+bool gnss_link_busy(const gnss_link_t *l);
+
+/** @brief Имя состояния для лога. */
+const char *gnss_link_state_name(gnss_link_state_t state);
+
+#endif /* PURRGO_GNSS_LINK_H */
