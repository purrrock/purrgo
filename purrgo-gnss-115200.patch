+    static const uint8_t expect_38400[] = {
+        0xB5, 0x62, 0x06, 0x8A, 0x0C, 0x00, 0x00, 0x01, 0x00, 0x00, 0x01, 0x00,
+        0x52, 0x40, 0x00, 0x96, 0x00, 0x00, 0xC6, 0x1F
