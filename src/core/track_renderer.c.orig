#include "purrgo/track_renderer.h"
#include "purrgo/track_logger.h"
#include "map_projection.h"
#include "purrgo/gfx_line.h"

void purrgo_track_render(
    gfx_context_t *gfx,
    const purrgo_bbox_t *camera,
    const purrgo_viewport_t *vp,
    const char *gpx_filepath)
{
    if (!gfx || !camera || !vp || !gpx_filepath) return;

    static track_point_t track_points[TRACK_RAM_MAX_POINTS];
    size_t num_points = purrgo_logger_get_track_points(track_points, TRACK_RAM_MAX_POINTS);

    if (num_points == 0) {
        return;
    }

    // Oтрисовывать трек нужно тонкой черной линией.
    gfx_set_color(gfx, BLACK, gfx->color_bg);

    bool has_prev = false;
    int16_t prev_sx = 0, prev_sy = 0;

    for (size_t i = 0; i < num_points; i++) {
        int16_t sx, sy;
        project_to_screen(track_points[i].lon_1e7, track_points[i].lat_1e7, camera, vp, &sx, &sy);

        if (has_prev) {
            gfx_draw_line(gfx, prev_sx, prev_sy, sx, sy);
        }
        prev_sx = sx;
        prev_sy = sy;
        has_prev = true;
    }
}

/**
 * @brief Renders only the most recently added segment of the track.
 *
 * This function is safe for incremental rendering because it directly reads
 * the RAM track buffer maintained by track_logger, ensuring we only render
 * what is actively being recorded without accessing the filesystem or reading
 * the GPX file. It only draws the segment between the last two points, and
 * limits its return region to the exact bounding box of this line segment
 * (plus a small safety margin), meaning we can use display_refresh_region()
 * instead of a full screen refresh. It assumes the map background and
 * camera position have not changed since the last full redraw.
 */
bool purrgo_track_render_last_segment(
    gfx_context_t *gfx,
    const purrgo_bbox_t *camera,
    const purrgo_viewport_t *vp,
    int16_t *min_x,
    int16_t *min_y,
    int16_t *max_x,
    int16_t *max_y)
{
    if (!gfx || !camera || !vp || !min_x || !min_y || !max_x || !max_y) return false;

    // Use a static buffer to avoid large stack frame allocation
    static track_point_t track_points[TRACK_RAM_MAX_POINTS];
    size_t num_points = purrgo_logger_get_track_points(track_points, TRACK_RAM_MAX_POINTS);

    // Need at least 2 points to draw a segment
    if (num_points < 2) {
        return false;
    }

    // Get the last two points
    track_point_t p1 = track_points[num_points - 2];
    track_point_t p2 = track_points[num_points - 1];

    int16_t sx1, sy1, sx2, sy2;
    project_to_screen(p1.lon_1e7, p1.lat_1e7, camera, vp, &sx1, &sy1);
    project_to_screen(p2.lon_1e7, p2.lat_1e7, camera, vp, &sx2, &sy2);

    // Calculate bounding box of the line segment
    int16_t lx = sx1 < sx2 ? sx1 : sx2;
    int16_t hx = sx1 > sx2 ? sx1 : sx2;
    int16_t ly = sy1 < sy2 ? sy1 : sy2;
    int16_t hy = sy1 > sy2 ? sy1 : sy2;

    // Add a small safety margin for line thickness and rounding
    int16_t margin = 2;
    lx -= margin;
    hx += margin;
    ly -= margin;
    hy += margin;

    // Clip to viewport
    if (lx < vp->offset_x) lx = vp->offset_x;
    if (hx >= vp->offset_x + vp->width) hx = vp->offset_x + vp->width - 1;
    if (ly < vp->offset_y) ly = vp->offset_y;
    if (hy >= vp->offset_y + vp->height) hy = vp->offset_y + vp->height - 1;

    // Check if line is completely outside viewport after bounding box check
    if (lx > hx || ly > hy) {
        return false;
    }

    // Save previous color state and set black for the track
    uint8_t old_fg, old_bg;
    gfx_get_color(gfx, &old_fg, &old_bg);
    gfx_set_color(gfx, BLACK, gfx->color_bg);

    // Draw the segment
    gfx_draw_line(gfx, sx1, sy1, sx2, sy2);

    // Restore color state
    gfx_set_color(gfx, old_fg, old_bg);

    // Return the bounding box
    *min_x = lx;
    *max_x = hx;
    *min_y = ly;
    *max_y = hy;

    return true;
}
