    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="У гэтым доме ў 1946-1947гг. жылі артыст тэатра Уладзіслава Галубка Міхаіл Лучанок і яго сын, будучы кампазітар, Народны артыст Беларусі і СССР, заслужаны дзеяч культуры Польшчы, Ганаровы грамадзянін г. Мар'іна Горка Ігар Лучанок"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Міхаіл і Ігар Лучанкі"/>
