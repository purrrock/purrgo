+              run "Дальние масштабы, как сейчас"                 "$lat" "$lon" --scales "50000,200000,500000"
+              run "Дальние масштабы, CLMT + min-px 2 + кэш 256"  "$lat" "$lon" --scales "50000,200000,500000" --fastseek --min-px 2 --cache 256
+            fi
+          done
+
+          {
+            echo "## Оценка времени загрузки экрана карты (sim_map_io.py)"
+            echo
+            echo "Модель, а не замер на железе. Время: I/O и CPU, секунды, low/mid/high."
