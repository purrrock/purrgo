         with:
-          name: ${{ env.ZIP_NAME }}
-          path: ${{ env.WORK }}/${{ env.ZIP_NAME }}
-          compression-level: 0
+          name: sim-report-${{ env.MAP_NAME }}
+          path: ${{ env.WORK }}/sim_report.txt
           retention-days: 30
+          if-no-files-found: ignore
 
