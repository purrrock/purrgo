diff --git a/apps/stm32/PurrGO_STM32U5/Core/Src/power_stm32.c b/apps/stm32/PurrGO_STM32U5/Core/Src/power_stm32.c
index 760642d..7fa9a28 100644
--- a/apps/stm32/PurrGO_STM32U5/Core/Src/power_stm32.c
+++ b/apps/stm32/PurrGO_STM32U5/Core/Src/power_stm32.c
@@ -67,6 +67,28 @@ void purrgo_platform_enter_standby(void)
     WRITE_REG(PWR->WUSCR, PWR_WUSCR_CWUF);
     __HAL_PWR_CLEAR_FLAG(PWR_FLAG_SBF);
 
+    /*
+     * Отладка в Standby: отладчик (ST-Link, IDE) выставляет DBG_STANDBY/DBG_STOP
+     * в DBGMCU_CR. С этими битами домен отладки остаётся под питанием, и на
+     * STM32U5 это известная причина «Standby входит, а WKUP не будит» (до
+     * полного снятия питания). Для штатной работы снимаем оба бита перед WFI.
+     */
+    CLEAR_BIT(DBGMCU->CR, DBGMCU_CR_DBG_STANDBY | DBGMCU_CR_DBG_STOP);
+
+    /*
+     * Диагностика пробуждения: реальное состояние регистров непосредственно
+     * перед WFI. Ожидается: WUCR1=0x01 (WUPEN1), WUCR2=0x01 (WUPP1, низкий
+     * уровень), WUCR3 бит 1:0 = 0 (WKUP1 = PA0), WUSR=0 (флагов нет),
+     * PUCRA.0=1, PDCRA.0=0, DBGMCU_CR.DBG_STANDBY=0, PA0=1 (кнопка отпущена).
+     */
+    PURRGO_LOG("STBY: WUCR1=0x%08lX WUCR2=0x%08lX WUCR3=0x%08lX WUSR=0x%08lX "
+               "PUCRA=0x%04lX PDCRA=0x%04lX DBGMCU_CR=0x%08lX PA0=%u\r\n",
+               (unsigned long)PWR->WUCR1, (unsigned long)PWR->WUCR2,
+               (unsigned long)PWR->WUCR3, (unsigned long)PWR->WUSR,
+               (unsigned long)PWR->PUCRA, (unsigned long)PWR->PDCRA,
+               (unsigned long)DBGMCU->CR,
+               (unsigned)HAL_GPIO_ReadPin(K1_GPIO_Port, K1_Pin));
+
     /*
      * Любое прерывание, ожидающее в NVIC (или SysTick 1 кГц), обрывает WFI:
      * МК остаётся в Run и падает в бесконечный цикл ниже - K1 его уже не
