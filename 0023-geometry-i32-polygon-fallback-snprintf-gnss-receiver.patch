diff --git a/include/purrgo/gnss_receiver.h b/include/purrgo/gnss_receiver.h
new file mode 100644
index 0000000..0a0c705
--- /dev/null
+++ b/include/purrgo/gnss_receiver.h
@@ -0,0 +1,43 @@
+#ifndef PURRGO_GNSS_RECEIVER_H
+#define PURRGO_GNSS_RECEIVER_H
+
+/*
+ * Настройка приёмника GNSS: команды, специфичные для конкретной модели, отделены
+ * от транспорта (UART/DMA, purrgo/gnss_io.h) и от разбора NMEA (gnss.c).
+ *
+ * Модель выбирается в hardware_config.h (PURRGO_HW_GNSS_RECEIVER). Модуль не
+ * зависит от платформы: платформа передаёт функцию отправки байт приёмнику, поэтому
+ * формат команд и контрольные суммы проверяются host-тестами
+ * (tests/host/test_gnss_receiver.c).
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Отправка байт приёмнику (блокирующая, например HAL_UART_Transmit). */
+typedef void (*purrgo_gnss_tx_fn)(const uint8_t *data, size_t len);
+
+/*
+ * Формирует NMEA-кадр "$<body>*HH\r\n" (HH - XOR всех символов body, две
+ * шестнадцатеричные цифры верхнего регистра) и '\0' в конце.
+ *
+ * body - тело команды БЕЗ '$' и '*HH', например "PCAS02,1000".
+ * Возвращает длину кадра без '\0'; 0, если кадр с '\0' не помещается в out.
+ */
+size_t purrgo_nmea_build_frame(char *out, size_t out_size, const char *body);
+
+/*
+ * Отправляет приёмнику стартовую конфигурацию выбранной модели.
+ * Вызывать после запуска приёма (DMA), чтобы не пропустить ответы приёмника.
+ */
+void purrgo_gnss_receiver_configure(purrgo_gnss_tx_fn tx);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PURRGO_GNSS_RECEIVER_H */
diff --git a/include/purrgo/hardware_config.h b/include/purrgo/hardware_config.h
index 2cf8ffa..63c53d0 100644
--- a/include/purrgo/hardware_config.h
+++ b/include/purrgo/hardware_config.h
@@ -20,6 +20,29 @@
 // #define PURRGO_GNSS_MOCK             1
 // #define PURRGO_HW_GNSS PURRGO_GNSS_MOCK
 
+/*
+ * Модель приёмника: определяет, какие настроечные команды ему отправляются при
+ * старте (см. purrgo/gnss_receiver.h).
+ *
+ *   PURRGO_GNSS_RECEIVER_NONE  - ничего не отправлять (приёмник работает с
+ *                                настройками по умолчанию);
+ *   PURRGO_GNSS_RECEIVER_CASIC - CASIC AT6558R (команды $PCAS...). Отладочный
+ *                                модуль; приёмник Release (G10A F30, u-blox M10)
+ *                                настраивается командами UBX - отдельная
+ *                                реализация в gnss_receiver.c.
+ */
+#define PURRGO_GNSS_RECEIVER_NONE   0
+#define PURRGO_GNSS_RECEIVER_CASIC  1
+
+#ifndef PURRGO_HW_GNSS_RECEIVER
+#define PURRGO_HW_GNSS_RECEIVER PURRGO_GNSS_RECEIVER_CASIC
+#endif
+
+#if (PURRGO_HW_GNSS_RECEIVER != PURRGO_GNSS_RECEIVER_NONE) && \
+    (PURRGO_HW_GNSS_RECEIVER != PURRGO_GNSS_RECEIVER_CASIC)
+#error "Invalid PURRGO_HW_GNSS_RECEIVER"
+#endif
+
 
 /*
  * Аппаратный backend дисплея. Единственный поддерживаемый - E-Ink
diff --git a/include/purrgo/logger.h b/include/purrgo/logger.h
index daef0af..960a72f 100644
--- a/include/purrgo/logger.h
+++ b/include/purrgo/logger.h
