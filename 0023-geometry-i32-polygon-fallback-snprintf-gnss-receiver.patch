+    const gfx_point_t *points,
+    uint16_t num_points,
+    const uint32_t *parts,
+    uint16_t num_parts,
+    int32_t y,
+    bool wide,
+    int16_t *nodeX,
+    uint16_t capacity,
+    uint16_t *out_nodes
