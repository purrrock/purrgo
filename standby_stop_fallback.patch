+     * ничему не мешает. K1 к этому моменту отпущена (см. ожидание выше).
+     */
+    const bool k1_released = (HAL_GPIO_ReadPin(K1_GPIO_Port, K1_Pin) == GPIO_PIN_SET);
+    if (k1_released)
+    {
+        GPIO_InitTypeDef k1 = {0};
+        k1.Pin = K1_Pin;
+        k1.Mode = GPIO_MODE_IT_FALLING;
+        k1.Pull = GPIO_PULLUP;
+        k1.Speed = GPIO_SPEED_FREQ_LOW;
+        HAL_GPIO_Init(K1_GPIO_Port, &k1);
+        __HAL_GPIO_EXTI_CLEAR_FALLING_IT(K1_Pin);
+        NVIC_ClearPendingIRQ(EXTI0_IRQn);
+        NVIC_EnableIRQ(EXTI0_IRQn);
+    }
+
